{%- comment -%}
  Galleria del prodotto: pagina prodotto (sections/main-product.liquid) e prodotto in evidenza
  (sections/featured-product.liquid). È la parte "media" di <product-page>: al cambio variante viene sostituita
  (frontend/scripts/product-page.js) e <product-media> si reinizializza da solo (frontend/scripts/product-media.js).

  - Carosello scroll-snap sotto i 990px; da 990px griglia o foto grande con miniature (layout).
  - Prima l'immagine della variante selezionata, poi le altre. Lightbox delle sole immagini, video e 3D al clic.

  Parametri:
  - product, featured_media
  - layout: 'grid' (default) | 'thumbnails'
  - main: true solo nella pagina prodotto → id #ProductMediaMain (arrivo dell'immagine condivisa delle transizioni
    tra pagine, snippets/page-transitions.liquid: deve essere unico) e titolo h2 nascosto della galleria
  - eager: true se la galleria è in cima alla pagina (prima immagine eager + fetchpriority high, LCP), default false
  - sizes_wide, sizes_narrow, sizes_single: sizes delle immagini larghe, a mezza colonna (griglia) e di un media unico;
    default quelli della pagina prodotto
{%- endcomment -%}
{%- liquid
  # Sotto i 990px: slide all'85% della lista, larga quanto lo schermo meno i margini (2 × 1,5rem). Con "85vw" il
  # telefono scaricava un formato in più per l'immagine LCP (Lighthouse mobile del 2026-11-11: 800px per 309px mostrati)
  assign sizes_wide = sizes_wide | default: '(min-width: 990px) 55vw, calc((100vw - 3rem) * 0.85)'
  assign sizes_narrow = sizes_narrow | default: '(min-width: 990px) 28vw, calc((100vw - 3rem) * 0.85)'
  assign sizes_single = sizes_single | default: '(min-width: 990px) 55vw, calc(100vw - 3rem)'

  # Prima l'immagine della variante selezionata, poi le altre
  assign gallery = product.media | where: 'id', featured_media.id
  assign other_media = product.media | reject: 'id', featured_media.id
  assign gallery = gallery | concat: other_media
  assign gallery_images = gallery | where: 'media_type', 'image'
  assign gallery_models = gallery | where: 'media_type', 'model'
  assign image_index = 0
  assign use_thumbnails = false
  if layout == 'thumbnails' and gallery.size > 1
    assign use_thumbnails = true
  endif
  # Griglia, da 990px: la prima occupa due colonne; con un numero pari di media l'ultima resterebbe sola, con un buco accanto
  assign last_is_wide = false
  assign remainder = gallery.size | modulo: 2
  if remainder == 0
    assign last_is_wide = true
  endif
-%}
<div data-product-part="media" data-featured-media-id="{{ featured_media.id }}">
  {%- if main -%}
    <h2 class="sr-only">{{ 'products.product.media.gallery' | t }}</h2>
  {%- endif -%}
  {%- comment -%} <product-media>: carosello, lightbox, video e 3D (frontend/scripts/product-media.js); senza JS la galleria resta consultabile {%- endcomment -%}
  <product-media class="block">
    {%- comment -%} data-scroll-region: su mobile (carosello) focusabile per scorrere da tastiera (frontend/scripts/scroll-regions.js) {%- endcomment -%}
    <ul
      class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-2 overflow-x-auto px-6 [scrollbar-width:none] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary lg:mx-0 lg:px-0{% if use_thumbnails %} lg:scroll-px-0 lg:gap-0{% else %} lg:grid lg:grid-cols-2 lg:gap-4 lg:overflow-visible{% endif %}"
      role="list"
      aria-label="{{ 'products.product.media.gallery' | t | escape }}"
      data-scroll-region
      data-media-list
    >
      {%- if gallery.size > 0 -%}
        {%- for media in gallery -%}
          {%- liquid
            assign is_wide = false
            if forloop.first or use_thumbnails
              assign is_wide = true
            elsif forloop.last and last_is_wide
              assign is_wide = true
            endif
            assign loading = 'lazy'
            assign priority = 'auto'
            if forloop.first and eager
              assign loading = 'eager'
              assign priority = 'high'
            endif
            assign sizes = sizes_narrow
            if is_wide
              assign sizes = sizes_wide
            endif
            if gallery.size == 1
              assign sizes = sizes_single
            endif
            assign alt = media.alt | default: product.title
            assign open_index = ''
            assign open_label = ''
            if media.media_type == 'image'
              assign open_index = image_index
              assign image_index = image_index | plus: 1
              assign open_label = 'products.product.media.open' | t: index: image_index, count: gallery_images.size
            endif
          -%}
          <li
            class="{% if gallery.size == 1 %}w-full{% else %}w-[85%]{% endif %} shrink-0 snap-center{% if use_thumbnails %} lg:w-full{% else %} lg:w-auto{% if is_wide %} lg:col-span-2{% endif %}{% endif %}"
            {% if media.media_type == 'model' %}
              data-model-id="{{ media.id }}"
            {% endif %}
          >
            {%- comment -%}
              #ProductMediaMain: arrivo dell'immagine condivisa con la card (snippets/page-transitions.liquid).
              h-full: con media di formati diversi ognuno riempie il riquadro del più alto, centrato sul fondo
            {%- endcomment -%}
            <div class="group/media media-loading relative flex h-full items-center overflow-hidden rounded-lg bg-surface"{% if forloop.first and main %} id="ProductMediaMain"{% endif %}>
              {% render 'product-media-item',
                media: media,
                product_title: product.title,
                alt: alt,
                loading: loading,
                priority: priority,
                sizes: sizes,
                open_index: open_index,
                open_label: open_label
              %}
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="w-full lg:col-span-2">
          <div class="aspect-square overflow-hidden rounded-lg bg-surface"{% if main %} id="ProductMediaMain"{% endif %}>
            {{ 'product-1' | placeholder_svg_tag: 'size-full fill-subtle' }}
          </div>
        </li>
      {%- endif -%}
    </ul>

    {%- if gallery.size > 1 -%}
      {%- comment -%}
        Sotto il carosello e non sopra: i comandi dei video stanno in basso sul media. Le frecce servono perché lo swipe
        da solo non basta: player e modelli 3D lo intercettano (linee guida Shopify sui media). Il contatore è nascosto
        ai lettori di schermo, che hanno già l'elenco.
      {%- endcomment -%}
      <div class="mt-3 hidden items-center justify-center gap-1 js:flex lg:hidden!">
        <button
          type="button"
          data-media-previous
          class="button button-subtle button-sm button-icon aria-disabled:bg-transparent"
          aria-disabled="true"
          aria-label="{{ 'products.product.media.previous' | t | escape }}"
        >
          {% render 'icon', name: 'chevron-left', size: 20 %}
        </button>
        <p class="min-w-12 text-center text-body-sm font-semibold text-foreground tabular-nums" aria-hidden="true">
          <span data-media-counter>1</span> / {{ gallery.size }}
        </p>
        <button
          type="button"
          data-media-next
          class="button button-subtle button-sm button-icon aria-disabled:bg-transparent"
          aria-label="{{ 'products.product.media.next' | t | escape }}"
        >
          {% render 'icon', name: 'chevron-right', size: 20 %}
        </button>
      </div>
    {%- endif -%}

    {%- if use_thumbnails -%}
      <ul class="mt-4 hidden flex-wrap gap-2 lg:js:flex" role="list" aria-label="{{ 'products.product.media.thumbnails' | t | escape }}">
        {%- for media in gallery -%}
          <li>
            <button
              type="button"
              data-media-thumb="{{ forloop.index0 }}"
              class="relative block size-20 overflow-hidden rounded-md border border-border bg-surface outline-offset-2 transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-primary aria-current:outline-2 aria-current:outline-foreground motion-reduce:transition-none"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.media.show' | t: index: forloop.index, count: gallery.size | escape }}"
            >
              {%- if media.preview_image -%}
                {{
                  media.preview_image
                  | image_url: width: 160
                  | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: '', class: 'size-full object-cover'
                }}
              {%- endif -%}
              {%- comment -%} Badge come da linee guida: in un angolo, almeno 20px, non oltre 1/9 della miniatura {%- endcomment -%}
              {%- unless media.media_type == 'image' -%}
                <span class="absolute end-1 bottom-1 grid size-5 place-items-center rounded-sm bg-background text-foreground/60">
                  {%- if media.media_type == 'model' -%}
                    {% render 'icon', name: 'cube', size: 16 %}
                  {%- else -%}
                    {% render 'icon', name: 'play', size: 16 %}
                  {%- endif -%}
                </span>
              {%- endunless -%}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- comment -%} "Vedi nel tuo spazio": solo sotto il media e sui dispositivi compatibili (Shopify toglie data-shopify-xr-hidden) {%- endcomment -%}
    {%- if gallery_models.size > 0 -%}
      <button
        type="button"
        class="button button-neutral mt-4 w-full data-shopify-xr-hidden:hidden"
        data-shopify-xr
        data-shopify-model3d-id="{{ gallery_models.first.id }}"
        data-shopify-title="{{ product.title | escape }}"
        data-shopify-xr-hidden
      >
        {% render 'icon', name: 'cube', size: 20 %}
        {{ 'products.product.media.xr' | t }}
      </button>
      <script type="application/json" data-product-models>
        {{ gallery_models | json }}
      </script>
    {%- endif -%}

    {%- if gallery_images.size > 0 -%}
      {% render 'product-lightbox', images: gallery_images, fallback_alt: product.title %}
    {%- endif -%}
  </product-media>
</div>
