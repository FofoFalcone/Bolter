{%- comment -%}
  Form di iscrizione alla newsletter: {% form 'customer' %} nativo (crea il cliente con accepts_marketing), funziona
  senza JS e mantiene il controllo hCaptcha. L'esito arriva dopo il ricaricamento con il messaggio che prende il focus.
  Usato da sections/newsletter.liquid e dal blocco "Newsletter" di sections/footer.liquid.

  Va messo dentro <contact-form data-sending-label="…"> (frontend/entrypoints/contact-form.js) per lo stato di invio:
  il pulsante ha data-contact-submit e l'etichetta data-contact-label.
  Il consenso è una casella senza name: blocca l'invio finché non è spuntata e non aggiunge campi al cliente.

  Probabile limite, non verificato su uno store: con due form 'customer' nella stessa pagina (es. la section newsletter
  e il blocco del footer) la conferma compare in entrambi, perché l'esito sembra dipendere dalla pagina e non dal
  singolo form.

  Parametri:
  - form_id: id del form, unico nella pagina (base degli id dei campi)
  - tags: tag aggiunti al cliente (contact[tags])
  - button_label: testo del pulsante (vuoto = "Iscriviti")
  - success_message: messaggio di conferma (vuoto = testo predefinito tradotto)
  - consent: 'checkbox' (casella obbligatoria) o 'notice' (testo informativo)
  - class: classi del form (larghezza e allineamento)

  Uso: {% render 'newsletter-form', form_id: form_id, tags: s.tags, button_label: s.button_label, success_message: s.success_message, consent: s.consent, class: 'w-full max-w-lg' %}
{%- endcomment -%}
{%- liquid
  assign error_id = form_id | append: '-error'

  # Testi svuotati dal merchant: quelli predefiniti, tradotti
  if button_label == blank
    assign button_label = 'sections.newsletter.submit' | t
  endif
  if success_message == blank
    assign success_message = 'sections.newsletter.success' | t
  endif

  assign consent_notice = 'sections.password.newsletter_consent_no_policy' | t
  assign consent_label = 'sections.newsletter.consent_label_no_policy' | t
  assign policy_missing = true
  if shop.privacy_policy != blank
    assign policy_missing = false
  endif
-%}
{%- if policy_missing == false -%}
  {%- capture privacy_link -%}
    <a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">{{ 'sections.password.privacy_policy' | t }}</a>
  {%- endcapture -%}
  {%- assign consent_notice = 'sections.password.newsletter_consent_html' | t: link: privacy_link -%}
  {%- assign consent_label = 'sections.newsletter.consent_label_html' | t: link: privacy_link -%}
{%- endif -%}
{%- capture field_class -%}
  block min-h-11 w-full min-w-0 flex-1 rounded-md border border-input-border bg-input px-4 py-2.5 text-body text-input-foreground transition-colors duration-150 placeholder:text-input-foreground/65 hover:border-input-foreground focus-visible:border-input-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-invalid:border-danger motion-reduce:transition-none
{%- endcapture -%}

{%- form 'customer', id: form_id, class: class -%}
  <div class="@container flex flex-col gap-3 text-start">
    <input type="hidden" name="contact[tags]" value="{{ tags | escape }}">

    {%- if form.posted_successfully? -%}
      <p
        class="flex items-start gap-2 rounded-md bg-positive-surface p-3 text-body text-positive-foreground transition-[opacity,translate] duration-300 ease-theme starting:translate-y-1 starting:opacity-0 motion-reduce:transition-none"
        role="status"
        tabindex="-1"
        autofocus
      >
        {% render 'icon', name: 'check-circle', size: 20, class: 'mt-0.5 shrink-0' %}
        {{ success_message | escape }}
      </p>
    {%- else -%}
      <label for="{{ form_id }}-email" class="text-body-sm font-semibold text-foreground">
        {{- 'sections.newsletter.email_label' | t -}}
      </label>
      {%- comment -%} Campo e pulsante affiancati se il form è largo almeno 24rem (anche in una colonna stretta del footer) {%- endcomment -%}
      <div class="flex flex-col gap-3 @sm:flex-row">
        <input
          id="{{ form_id }}-email"
          class="{{ field_class }}"
          type="email"
          name="contact[email]"
          value="{{ form.email | escape }}"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="{{ error_id }}"
          {% endif %}
        >
        <button type="submit" class="button button-primary shrink-0" data-contact-submit>
          <span data-contact-label>{{ button_label | escape }}</span>
        </button>
      </div>

      {%- if form.errors -%}
        <p id="{{ error_id }}" class="text-body-sm text-danger-foreground">
          {%- for error in form.errors -%}
            {%- unless error == 'form' -%}
              {{- form.errors.translated_fields[error] | capitalize }}{{ ' ' }}
            {%- endunless -%}
            {{- form.errors.messages[error] }}{{ ' ' }}
          {%- endfor -%}
        </p>
      {%- endif -%}

      {%- if consent == 'checkbox' -%}
        {% render 'contact-form-checkbox',
          id: form_id,
          key: 'consent',
          text: consent_label,
          policy_missing: policy_missing
        %}
      {%- else -%}
        <p class="text-body-sm text-pretty text-foreground/80 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-foreground">
          {{- consent_notice -}}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endform -%}
