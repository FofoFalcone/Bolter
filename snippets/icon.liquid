{%- comment -%}
  FILE GENERATO da tools/build-icons.mjs — non modificare a mano.
  Icone: Heroicons (https://heroicons.com), Copyright (c) Tailwind Labs, Inc., licenza MIT (testo in snippets/license.liquid).
  Elenco in tools/icons.json, rigenera con: npm run icons

  Parametri:
  - name: nome dell'icona (chevron-down, arrow-right, chevron-left, chevron-right, x-mark, plus, minus, check, bars-3, magnifying-glass, magnifying-glass-plus, magnifying-glass-minus, cube, shopping-bag, user, play, pause, exclamation-triangle, language, adjustments-horizontal, check-circle, exclamation-circle, map-pin, envelope, phone, clock, chat-bubble-left-right, building-storefront, document-text, newspaper, truck, shield-check, arrow-path, credit-card, lock-closed, gift, sparkles, star, heart, globe-alt, check-badge, tag, star-solid, chevron-up-down, arrows-right-left)
  - size: 16, 20 (predefinita), 24, 32, 48 o 'full'. Sceglie il disegno nitido per quella misura e la classe size-*:
    non mettere la misura di base in class (solo varianti, es. lg:size-6). npm run lint lo controlla.
  - style: 'solid' per le icone a contorno da 24px in su che devono essere piene (es. header). Sotto i 24px sono
    sempre piene.
  - class: altre classi CSS, es. 'shrink-0'
{%- endcomment -%}
{%- liquid
  assign icon_grid = 20
  assign icon_class = 'size-5'
  case size
    when 16
      assign icon_grid = 16
      assign icon_class = 'size-4'
    when 20
      assign icon_grid = 20
      assign icon_class = 'size-5'
    when 24
      assign icon_grid = 24
      assign icon_class = 'size-6'
    when 32
      assign icon_grid = 24
      assign icon_class = 'size-8'
    when 48
      assign icon_grid = 24
      assign icon_class = 'size-12'
    when 'full'
      assign icon_grid = 24
      assign icon_class = 'size-full'
  endcase
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif

  case icon_grid
    when 16
      render 'icon-16', name: name, icon_class: icon_class
    when 24
      render 'icon-24', name: name, icon_class: icon_class, style: style
    else
      render 'icon-20', name: name, icon_class: icon_class
  endcase
-%}
