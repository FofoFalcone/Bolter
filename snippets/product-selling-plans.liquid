{%- comment -%}
  Opzioni di acquisto (abbonamenti, preordini, prova prima di comprare): radio dentro il form prodotto con
  name="selling_plan" (valore vuoto = acquisto singolo), quindi funziona anche senza JS. Si mostrano solo i piani
  disponibili per la variante corrente. Con JS (frontend/scripts/product-page.js) la scelta aggiorna il prezzo con la
  Section Rendering API (parametro selling_plan) e resta nell'URL.

  Se tutta la variante richiede un piano non c'è l'acquisto singolo e il primo piano è già scelto.

  Parametri:
  - product: prodotto (obbligatorio)
  - variant: variante corrente (obbligatorio)
  - section_id: id della section (obbligatorio)

  Uso: {% render 'product-selling-plans', product: product, variant: variant, section_id: section_id %}
{%- endcomment -%}
{%- if variant != blank and variant.selling_plan_allocations.size > 0 -%}
  {%- liquid
    assign selected_id = product.selected_selling_plan.id
    assign has_selected = false
    for allocation in variant.selling_plan_allocations
      if allocation.selling_plan.id == selected_id
        assign has_selected = true
      endif
    endfor
    if has_selected == false and variant.requires_selling_plan
      assign selected_id = variant.selling_plan_allocations.first.selling_plan.id
      assign has_selected = true
    endif
  -%}
  {%- capture row_class -%}
    flex cursor-pointer items-start justify-between gap-4 rounded-md border border-border-strong bg-background p-3 transition-[color,background-color,border-color,scale] duration-150 hover:bg-surface motion-safe:active:scale-[0.99] peer-checked:border-foreground peer-checked:bg-surface peer-checked:ring-1 peer-checked:ring-foreground peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary motion-reduce:transition-none
  {%- endcapture -%}

  <fieldset class="flex flex-col gap-3">
    <legend class="mb-2 text-body-sm font-semibold text-foreground">{{ 'products.product.selling_plans.legend' | t }}</legend>

    {%- unless variant.requires_selling_plan -%}
      <div>
        <input
          type="radio"
          class="peer sr-only"
          id="SellingPlan-{{ section_id }}-none"
          name="selling_plan"
          value=""
          {% unless has_selected %}
            checked
          {% endunless %}
        >
        <label for="SellingPlan-{{ section_id }}-none" class="{{ row_class }}">
          <span class="text-body font-semibold text-foreground">{{ 'products.product.selling_plans.one_time' | t }}</span>
          <span class="shrink-0 text-body text-foreground">{{ variant.price | money }}</span>
        </label>
      </div>
    {%- endunless -%}

    {%- for group in product.selling_plan_groups -%}
      {%- for allocation in variant.selling_plan_allocations -%}
        {%- if allocation.selling_plan_group_id == group.id -%}
          {%- assign plan = allocation.selling_plan -%}
          <div>
            <input
              type="radio"
              class="peer sr-only"
              id="SellingPlan-{{ section_id }}-{{ plan.id }}"
              name="selling_plan"
              value="{{ plan.id }}"
              {% if has_selected and plan.id == selected_id %}
                checked
              {% endif %}
            >
            <label for="SellingPlan-{{ section_id }}-{{ plan.id }}" class="{{ row_class }}">
              <span class="flex min-w-0 flex-col gap-1">
                <span class="text-body font-semibold text-foreground">
                  {%- if product.selling_plan_groups.size > 1 -%}
                    {{- group.name | escape }}:{{ ' ' }}
                  {%- endif -%}
                  {{- plan.name | escape -}}
                </span>
                {%- if plan.description != blank -%}
                  <span class="text-body-sm text-pretty text-foreground/80">{{ plan.description | escape }}</span>
                {%- endif -%}
                {%- comment -%} Preordini e prova: si paga una parte oggi e il resto più avanti {%- endcomment -%}
                {%- if allocation.remaining_balance_charge_amount > 0 -%}
                  {%- liquid
                    assign pay_today = allocation.checkout_charge_amount | money
                    assign pay_later = allocation.remaining_balance_charge_amount | money
                  -%}
                  <span class="text-body-sm text-foreground/80">
                    {{- 'products.product.selling_plans.pay_today_html' | t: today: pay_today, later: pay_later -}}
                  </span>
                {%- endif -%}
              </span>
              <span class="flex shrink-0 flex-col items-end text-end">
                <span class="text-body text-foreground">{{ allocation.price | money }}</span>
                {%- if allocation.compare_at_price > allocation.price -%}
                  <span class="sr-only">{{ 'products.product.price.regular' | t }}</span>
                  <s class="text-body-sm text-foreground/80">{{ allocation.compare_at_price | money }}</s>
                {%- endif -%}
              </span>
            </label>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </fieldset>
{%- endif -%}
