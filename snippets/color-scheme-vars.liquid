{%- comment -%}
  Dichiarazioni CSS di uno schema di colori (Impostazioni tema → Colori), da stampare dentro una regola: :root in
  snippets/head-styles.liquid, il wrapper della section in snippets/section-colors.liquid.

  - Obbligatori (background, foreground, primary, primary_foreground): diventano i token --color-*.
  - Facoltativi: --scheme-<nome> col colore scelto, oppure `initial` se vuoto. `initial` serve anche a non ereditare
    il valore dello schema della pagina: con var(--scheme-x, calcolo) in frontend/styles/tokens.css vale il calcolo.
  Per aggiungere un colore facoltativo: definition in config/settings_schema.json, una riga qui sotto, token e calcolo
  in tokens.css. Righe esplicite invece di un ciclo con colors[key]: l'accesso con chiave dinamica alle impostazioni
  di uno schema non è documentato.

  Parametri:
  - scheme: oggetto color_scheme

  Uso: {% render 'color-scheme-vars', scheme: scheme %}
{%- endcomment -%}
{%- comment -%}
  --card-scheme-*: i colori facoltativi pensati per lo sfondo della section (titoli, bordi, pulsante secondario,
  campi) valgono anche dentro le card (utility card-colors, frontend/styles/utilities.css) solo se la card ha lo
  stesso sfondo della section. Con una card di un altro colore (es. card bianche in una section arancione) sono
  `initial` e dentro la card si ricalcolano dai colori della card: altrimenti un bordo arancione scuro finirebbe
  attorno a una card bianca, o titoli chiari pensati per uno sfondo scuro su una card bianca.
{%- endcomment -%}
{%- liquid
  assign colors = scheme.settings
  assign brightness = colors.background | color_brightness
  assign card_hex = colors.card | append: ''
  assign background_hex = colors.background | append: ''
  assign card_matches = true
  if card_hex != blank and card_hex != background_hex
    assign card_matches = false
  endif

  # Testo attenuato e bordi forti: quota minima di testo (dal 65% / 60% del SDS a salire) che dà almeno 4.5:1 sul fondo
  # surface (testo, caso peggiore) e 3:1 sullo sfondo (bordi dei controlli). Con bianco e nero restano i valori SDS; su
  # fondi di tono medio o saturi (arancione, blu, terracotta) la percentuale fissa scendeva a 3-4:1. color_contrast
  # arrotonda a un decimale: soglie 4.6 e 3.1 per restare sopra il minimo. Stesso calcolo sui colori delle card.
  assign foreground_hex = colors.foreground | append: ''
  assign card_foreground_hex = colors.card_foreground | append: '' | default: foreground_hex
  assign card_background_hex = card_hex | default: background_hex
  assign muted_mix = 100
  assign strong_mix = 100
  assign card_muted_mix = 100
  assign surface = foreground_hex | color_mix: background_hex, 5
  assign card_surface = card_foreground_hex | color_mix: card_background_hex, 5
  for step in (13..20)
    assign pct = step | times: 5
    assign candidate = foreground_hex | color_mix: background_hex, pct
    assign ratio = candidate | color_contrast: surface
    if ratio >= 4.6
      assign muted_mix = pct
      break
    endif
  endfor
  for step in (12..20)
    assign pct = step | times: 5
    assign candidate = foreground_hex | color_mix: background_hex, pct
    assign ratio = candidate | color_contrast: background_hex
    if ratio >= 3.1
      assign strong_mix = pct
      break
    endif
  endfor
  for step in (13..20)
    assign pct = step | times: 5
    assign candidate = card_foreground_hex | color_mix: card_background_hex, pct
    assign ratio = candidate | color_contrast: card_surface
    if ratio >= 4.6
      assign card_muted_mix = pct
      break
    endif
  endfor
-%}
--muted-mix: {{ muted_mix }}%;
--strong-mix: {{ strong_mix }}%;
--card-muted-mix: {{ card_muted_mix }}%;
--color-background: {{ colors.background }};
--color-foreground: {{ colors.foreground }};
--color-primary: {{ colors.primary }};
--color-primary-foreground: {{ colors.primary_foreground }};
--scheme-headings: {{ colors.headings | default: 'initial' }};
--scheme-border: {{ colors.border | default: 'initial' }};
--scheme-secondary: {{ colors.secondary | default: 'initial' }};
--scheme-secondary-foreground: {{ colors.secondary_foreground | default: 'initial' }};
--scheme-secondary-border: {{ colors.secondary_border | default: 'initial' }};
--scheme-card: {{ colors.card | default: 'initial' }};
--scheme-card-foreground: {{ colors.card_foreground | default: 'initial' }};
--scheme-badge-sale: {{ colors.badge_sale | default: 'initial' }};
--scheme-badge-sale-foreground: {{ colors.badge_sale_foreground | default: 'initial' }};
--scheme-input: {{ colors.input | default: 'initial' }};
--scheme-input-foreground: {{ colors.input_foreground | default: 'initial' }};
--scheme-input-border: {{ colors.input_border | default: 'initial' }};
{%- if card_matches %}
--card-scheme-headings: {{ colors.headings | default: 'initial' }};
--card-scheme-border: {{ colors.border | default: 'initial' }};
--card-scheme-secondary: {{ colors.secondary | default: 'initial' }};
--card-scheme-secondary-foreground: {{ colors.secondary_foreground | default: 'initial' }};
--card-scheme-secondary-border: {{ colors.secondary_border | default: 'initial' }};
--card-scheme-input: {{ colors.input | default: 'initial' }};
--card-scheme-input-foreground: {{ colors.input_foreground | default: 'initial' }};
--card-scheme-input-border: {{ colors.input_border | default: 'initial' }};
{%- else %}
--card-scheme-headings: initial;
--card-scheme-border: initial;
--card-scheme-secondary: initial;
--card-scheme-secondary-foreground: initial;
--card-scheme-secondary-border: initial;
--card-scheme-input: initial;
--card-scheme-input-foreground: initial;
--card-scheme-input-border: initial;
{%- endif %}
color-scheme: {% if brightness < 128 %}dark{% else %}light{% endif %};
