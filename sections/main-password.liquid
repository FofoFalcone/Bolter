{%- comment -%}
  Pagina password (templates/password.json + layout/password.liquid): pannello centrato con logo, titolo, messaggio
  scritto dal merchant (Negozio online → Preferenze), iscrizione alla newsletter e accesso con la password.
  Tutto con form nativi, senza JS: l'esito arriva dopo il ricaricamento con il messaggio che prende il focus.
  Immagine di sfondo facoltativa: il testo sta sempre nel pannello pieno, quindi il contrasto non dipende dall'immagine.

  - Newsletter: {% form 'customer' %} con contact[tags] "prospect, password page" (documentazione Shopify).
  - Password: {% form 'storefront_password' %} in un <details>, aperto da solo se la password è sbagliata.
  - Sugli store di sviluppo Shopify mostra sempre la propria pagina password: questa si vede solo su /password da
    connessi o nel theme editor.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{%- liquid
  assign s = section.settings
  assign logo = s.logo | default: shop.brand.logo
  assign newsletter_id = 'PasswordNewsletter-' | append: section.id
  assign password_id = 'PasswordForm-' | append: section.id
-%}
{%- capture field_class -%}
  block w-full min-h-11 rounded-md border border-input-border bg-input px-4 py-2.5 text-body text-input-foreground transition-colors duration-150 placeholder:text-input-foreground/65 hover:border-input-foreground focus-visible:border-input-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-invalid:border-danger motion-reduce:transition-none
{%- endcapture -%}

<div class="relative isolate flex min-h-svh flex-col items-center justify-center gap-6 px-4 py-8 md:py-16">
  {%- if s.background_image != blank -%}
    {{
      s.background_image
      | image_url: width: 2400
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 2000, 2400',
        alt: '',
        class: 'absolute inset-0 -z-10 size-full object-cover'
    }}
  {%- endif -%}

  <div class="flex w-full max-w-lg flex-col gap-8 rounded-xl bg-background p-6 shadow-500 md:p-10">
    <header class="flex flex-col items-center gap-6 text-center">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: 480
          | image_tag: loading: 'eager', widths: '160, 320, 480', sizes: '160px', alt: shop.name, class: 'h-auto w-40'
        }}
      {%- else -%}
        <p class="text-heading text-foreground">{{ shop.name | escape }}</p>
      {%- endif -%}

      <h1 class="text-heading text-balance text-headings md:text-subtitle">
        {{- s.heading | default: shop.name | escape -}}
      </h1>

      {%- unless shop.password_message == blank -%}
        <div class="prose prose-theme max-w-none text-body text-pretty text-foreground/80">
          {{ shop.password_message }}
        </div>
      {%- endunless -%}
    </header>

    {%- if s.show_newsletter -%}
      {%- form 'customer', id: newsletter_id, class: 'flex flex-col gap-3' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">

        {%- if form.posted_successfully? -%}
          <p
            class="flex items-start gap-2 rounded-md bg-positive-surface p-3 text-body-sm text-positive-foreground"
            role="status"
            tabindex="-1"
            autofocus
          >
            {% render 'icon', name: 'check-circle', class: 'mt-0.5 size-5 shrink-0' %}
            {{ 'sections.password.newsletter_success' | t }}
          </p>
        {%- else -%}
          <label for="{{ newsletter_id }}-email" class="text-body-sm font-semibold text-foreground">
            {{- 'sections.password.newsletter_label' | t -}}
          </label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input
              id="{{ newsletter_id }}-email"
              class="{{ field_class }} min-w-0 flex-1"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="{{ newsletter_id }}-error"
              {% endif %}
            >
            <button type="submit" class="button button-primary shrink-0">
              {{- 'sections.password.newsletter_submit' | t -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p id="{{ newsletter_id }}-error" class="text-body-sm text-danger-foreground">
              {%- for error in form.errors -%}
                {%- unless error == 'form' -%}
                  {{- form.errors.translated_fields[error] | capitalize }}{{ ' ' }}
                {%- endunless -%}
                {{- form.errors.messages[error] }}{{ ' ' }}
              {%- endfor -%}
            </p>
          {%- endif -%}
          <p class="text-body-sm text-pretty text-foreground/80">
            {%- if shop.privacy_policy != blank -%}
              {%- capture privacy_link -%}
                <a href="{{ shop.privacy_policy.url }}" class="underline underline-offset-4 hover:text-foreground">
                  {{- 'sections.password.privacy_policy' | t -}}
                </a>
              {%- endcapture -%}
              {{ 'sections.password.newsletter_consent_html' | t: link: privacy_link }}
            {%- else -%}
              {{ 'sections.password.newsletter_consent_no_policy' | t }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- form 'storefront_password', id: password_id, class: 'border-t border-border pt-4' -%}
      <details class="group"{% if form.errors %} open{% endif %}>
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-sm text-body font-semibold text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary [&::-webkit-details-marker]:hidden">
          {{- 'sections.password.enter_with_password' | t -}}
          {% render 'icon',
            name: 'chevron-down',
            class: 'size-5 shrink-0 transition-transform duration-200 ease-theme group-open:rotate-180 motion-reduce:transition-none'
          %}
        </summary>

        <div class="flex flex-col gap-3 pt-3">
          <label for="{{ password_id }}-input" class="text-body-sm font-semibold text-foreground">
            {{- 'sections.password.password_label' | t -}}
          </label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <input
              id="{{ password_id }}-input"
              class="{{ field_class }} min-w-0 flex-1"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="{{ password_id }}-error"
              {% endif %}
            >
            <button type="submit" class="button button-neutral shrink-0">
              {{- 'sections.password.enter' | t -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p id="{{ password_id }}-error" class="text-body-sm text-danger-foreground">
              {{- 'sections.password.wrong_password' | t -}}
            </p>
          {%- endif -%}
        </div>
      </details>
    {%- endform -%}
  </div>

  {%- comment -%} Sopra un'immagine il testo resta su un fondo pieno, come il pannello {%- endcomment -%}
  <footer class="flex flex-col items-center gap-1 rounded-md bg-background px-4 py-2 text-center text-body-sm text-foreground/80 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-foreground">
    <p>{{ 'sections.password.admin_link_html' | t }}</p>
    {%- if s.show_powered_by -%}
      <p>{{ powered_by_link }}</p>
    {%- endif -%}
  </footer>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-main-password",
  "enabled_on": {
    "templates": [
      "password"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main_password.settings.logo.label",
      "info": "t:sections.main_password.settings.logo.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_password.settings.heading.label",
      "default": "t:sections.main_password.settings.heading.default"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.main_password.settings.background_image.label",
      "info": "t:sections.main_password.settings.background_image.info"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.settings.show_newsletter.label",
      "info": "t:sections.main_password.settings.show_newsletter.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:sections.main_password.settings.show_powered_by.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_password.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_password.settings.color_scheme.label",
      "info": "t:sections.main_password.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
