{%- comment -%}
  Immagine con testo in parallax.
  Basata sull'esempio Motion "Parallax" (https://motion.dev/examples/js-parallax):
  l'immagine scorre dentro la cornice e il testo si muove in direzione opposta durante lo scroll.
  Senza JS o con prefers-reduced-motion la section è statica.
  Stile: utility Tailwind (nessun CSS dedicato). JS: frontend/entrypoints/image-with-text-parallax.js
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}

{%- liquid
  case section.settings.intensity
    when 'subtle'
      assign offset = 40
    when 'strong'
      assign offset = 120
    else
      assign offset = 80
  endcase

  # A tutta larghezza, sotto i 990px (colonna unica) l'immagine arriva ai bordi dello schermo
  assign media_class = 'rounded-lg'
  assign image_max = 1600
  assign image_widths = '600, 800, 1000, 1200, 1600'
  if section.settings.section_width == 'full'
    assign media_class = '-mx-(--page-gutter) lg:mx-0 lg:rounded-lg'
    assign image_max = 2600
    assign image_widths = image_widths | append: ', 2000, 2600'
  endif
-%}

{%- comment -%}
  js-motion: con il movimento attivo l'immagine è più alta della cornice di 2 * offset
  (top: -offset), così la traslazione -offset → +offset del JS non scopre mai i bordi.
{%- endcomment -%}
{%- capture image_class -%}
  parallax__image block size-full object-cover js-motion:absolute js-motion:inset-x-0 js-motion:-top-(--parallax-offset) js-motion:h-[calc(100%+var(--parallax-offset)*2)] js-motion:will-change-[translate]
{%- endcapture -%}

<parallax-section
  class="page-width grid items-center gap-8 py-8 md:py-16 lg:grid-cols-2 lg:gap-16"
  style="--parallax-offset: {{ offset }}px;"
  data-offset="{{ offset }}"
>
  <div class="relative aspect-4/5 overflow-hidden {{ media_class }} bg-surface{% if section.settings.image_position == 'right' %} lg:order-2{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- liquid
        # Prima section della pagina: probabile immagine LCP
        assign loading = 'lazy'
        assign fetchpriority = 'auto'
        if section.index == 1
          assign loading = 'eager'
          assign fetchpriority = 'high'
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: image_max
        | image_tag:
          loading: loading,
          fetchpriority: fetchpriority,
          widths: image_widths,
          sizes: '(min-width: 990px) 50vw, 100vw',
          class: image_class
      }}
    {%- else -%}
      <div class="{{ image_class }}">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'size-full fill-subtle' }}
      </div>
    {%- endif -%}
  </div>

  <div class="flex flex-col items-start gap-4 js-motion:will-change-[translate]" data-parallax-content>
    {%- if section.settings.label != blank -%}
      <p class="text-body-sm font-semibold text-muted">{{ section.settings.label | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="text-heading text-headings md:text-title-page">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="prose prose-theme max-w-none text-subheading [--tw-prose-body:var(--color-muted)]">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="button button-primary mt-2" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</parallax-section>

{% render 'vite-tag', entry: 'image-with-text-parallax.js' %}

