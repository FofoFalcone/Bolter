{%- comment -%}
  Tabella di confronto: righe di caratteristiche (blocchi) confrontate su 2-4 colonne (es. "Noi" e "Gli altri", o
  tre modelli). Solo Liquid, nessun JS.

  - <table> semantico: <caption> nascosta, <th scope="col"> per le colonne, <th scope="row"> per le caratteristiche.
  - Valori: "sì"/"si"/"yes"/"✓" diventano una spunta, "no"/"✗" una croce (con il testo per i lettori di schermo),
    tutto il resto si mostra com'è.
  - Colonna in evidenza (setting highlight): fondo colorato dall'intestazione all'ultima riga.
  - Sotto i 750px, se non ci sta, la tabella scorre in orizzontale con la prima colonna ferma (data-scroll-region:
    focusabile solo quando scorre, frontend/scripts/scroll-regions.js), dentro i margini della pagina.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, background: section.settings.color_background, text: section.settings.color_text %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  assign s = section.settings
  assign columns = s.columns | plus: 0
  assign highlight = s.highlight | plus: 0
  assign yes_values = 'sì,si,yes,y,✓,✔,true' | split: ','
  assign no_values = 'no,n,✗,✕,×,false' | split: ','
  if s.heading != blank
    assign caption = s.heading
  else
    assign caption = 'sections.comparison_table.caption' | t
  endif
-%}

<div class="page-width flex flex-col gap-8 py-8 md:gap-12 md:py-16">
  {% render 'section-header', heading: s.heading, intro: s.intro, align: s.align %}

  {%- if section.blocks.size > 0 -%}
    <div
      class="mx-auto w-full max-w-4xl overflow-x-auto rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      role="region"
      aria-label="{{ caption | escape }}"
      data-scroll-region
      {% unless section.index == 1 or request.visual_preview_mode %}
        data-animate="fade-up"
      {% endunless %}
    >
      <table class="w-full min-w-120 border-separate border-spacing-0 text-body text-foreground">
        <caption class="sr-only">{{ caption | escape }}</caption>
        <thead>
          <tr>
            <td class="sticky left-0 z-10 w-2/5 bg-background"></td>
            {%- for i in (1..columns) -%}
              {%- liquid
                assign key = 'column_' | append: i
                assign title = s[key]
                if title == blank
                  assign title = 'sections.comparison_table.column' | t: number: i
                endif
              -%}
              <th
                scope="col"
                class="px-3 pt-4 pb-3 text-center align-bottom text-body font-semibold text-balance{% if i == highlight %} rounded-t-lg bg-surface text-subheading{% endif %}"
              >
                {{- title | escape -}}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th
                scope="row"
                class="sticky left-0 z-10 border-t border-border bg-background py-4 pe-4 text-start align-middle font-normal text-pretty"
              >
                {{- block.settings.label | escape -}}
              </th>
              {%- for i in (1..columns) -%}
                {%- liquid
                  assign key = 'value_' | append: i
                  assign value = block.settings[key] | strip
                  assign normalized = value | downcase
                  assign cell_class = 'border-t border-border px-3 py-4 text-center align-middle'
                  if i == highlight
                    assign cell_class = cell_class | append: ' bg-surface font-semibold'
                    if forloop.parentloop.last
                      assign cell_class = cell_class | append: ' rounded-b-lg'
                    endif
                  endif
                -%}
                <td class="{{ cell_class }}">
                  {%- if yes_values contains normalized -%}
                    <span class="inline-grid size-7 place-items-center rounded-full bg-primary text-primary-foreground">
                      {% render 'icon', name: 'check', class: 'size-4' %}
                    </span>
                    <span class="sr-only">{{ 'sections.comparison_table.yes' | t }}</span>
                  {%- elsif no_values contains normalized -%}
                    <span class="inline-grid size-7 place-items-center rounded-full text-foreground/60">
                      {% render 'icon', name: 'x-mark', class: 'size-5' %}
                    </span>
                    <span class="sr-only">{{ 'sections.comparison_table.no' | t }}</span>
                  {%- elsif value != blank -%}
                    {{ value | escape }}
                  {%- else -%}
                    <span aria-hidden="true" class="text-foreground/60">–</span>
                    <span class="sr-only">{{ 'sections.comparison_table.empty' | t }}</span>
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.comparison_table.name",
  "tag": "section",
  "class": "section-comparison-table",
  "max_blocks": 20,
  "disabled_on": {
