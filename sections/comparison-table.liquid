          "label": "t:sections.comparison_table.settings.highlight.options.0"
        },
        {
          "value": "1",
          "label": "t:sections.comparison_table.settings.highlight.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.comparison_table.settings.highlight.options.2"
        },
        {
          "value": "3",
          "label": "t:sections.comparison_table.settings.highlight.options.3"
        },
        {
          "value": "4",
          "label": "t:sections.comparison_table.settings.highlight.options.4"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:sections.comparison_table.settings.header_2.content"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.comparison_table.settings.color_background.label",
      "info": "t:sections.comparison_table.settings.color_background.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.comparison_table.settings.color_text.label",
      "info": "t:sections.comparison_table.settings.color_text.info"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.comparison_table.blocks.row.name",
      "settings": [
        {
          "type": "text",
