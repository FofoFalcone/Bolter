      "options": [
        {
          "value": "page",
          "label": "t:sections.comparison_table.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.comparison_table.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.comparison_table.settings.heading.label",
      "default": "t:sections.comparison_table.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.comparison_table.settings.intro.label"
    },
    {
      "type": "select",
