          "value": "start",
          "label": "t:sections.comparison_table.settings.align.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.comparison_table.settings.align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.comparison_table.settings.header_1.content"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.comparison_table.settings.columns.label",
      "options": [
        {
          "value": "2",
          "label": "t:sections.comparison_table.settings.columns.options.2"
        },
        {
          "value": "3",
          "label": "t:sections.comparison_table.settings.columns.options.3"
        },
        {
          "value": "4",
          "label": "t:sections.comparison_table.settings.columns.options.4"
        }
      ],
      "default": "2"
    },
    {
