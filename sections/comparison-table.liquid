      "label": "t:sections.comparison_table.settings.column_4.label",
      "visible_if": "{{ section.settings.columns == '4' }}"
    },
    {
      "type": "select",
      "id": "highlight",
      "label": "t:sections.comparison_table.settings.highlight.label",
