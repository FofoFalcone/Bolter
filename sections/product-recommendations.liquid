{%- comment -%}
  Prodotti consigliati (template prodotto) con la Product Recommendations API di Shopify: la stessa section fa da
  risposta, richiesta a routes.product_recommendations_url con product_id, section_id, limit e intent
  (related = "Ti potrebbe piacere", complementary = "Abbinalo a", configurati nell'app Search & Discovery).

  - Prima della risposta (recommendations.performed? falso): scheletro con lo spazio delle card, niente contenuto.
  - <product-recommendations> (frontend/entrypoints/product-recommendations.js) richiede la section quando sta per
    entrare nello schermo e sostituisce il contenuto; senza consigli la section sparisce (nell'editor resta un avviso).
  - Card: product-card con contesto "recommendation" per shopify:product:view (quando la card entra nello schermo).
  - Sotto i 750px le card scorrono in orizzontale (scroll-snap), da 750px sono in griglia.
  Senza JS la section non mostra nulla: i consigli esistono solo come risposta dell'API.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign full_width = false
  if section.settings.section_width == 'full'
    assign page_max = '100vw'
    assign full_width = true
  endif
  assign s = section.settings
  assign limit = s.limit
  assign columns = s.columns_desktop
  assign columns_md = columns | at_most: 3
  if recommendations.performed?
    assign heading = s.heading
    if recommendations.intent == 'complementary' and s.heading == blank
      assign heading = 'sections.product_recommendations.complementary_heading' | t
    elsif s.heading == blank
      assign heading = 'sections.product_recommendations.related_heading' | t
    endif
  endif
  capture sizes
    echo '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 4rem - ' | append: columns | append: ' * 1.5rem) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 4rem) / ' | append: columns_md | append: '), 70vw'
  endcapture
  # Sotto i 750px la fila scorre e taglierebbe l'ombra delle card: spazio sopra e sotto, compensato dai margini
  assign scroll_padding = 'pb-2'
  if settings.product_card_shadow != 'none'
    assign scroll_padding = 'pt-2 pb-10 -mt-2 -mb-8 md:my-0 md:pt-0'
  endif
  capture list_class
    echo 'flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain [scrollbar-width:thin] '
    echo scroll_padding
    echo ' -mx-4 scroll-px-4 px-4 md:mx-0 md:grid md:snap-none md:overflow-visible md:px-0 md:pb-0 md:gap-6'
    echo ' md:grid-cols-[repeat(var(--columns-md),minmax(0,1fr))] lg:grid-cols-[repeat(var(--columns),minmax(0,1fr))]'
  endcapture
  assign item_class = 'w-[70vw] max-w-72 shrink-0 snap-start md:w-auto md:max-w-none'
-%}

{%- unless recommendations.performed? -%}
  {% render 'vite-tag', entry: 'product-recommendations.js' %}
{%- endunless -%}

<product-recommendations
  class="block"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ s.intent }}"
>
  <div class="page-width py-8 md:py-16" data-recommendations-content>
    {%- if recommendations.performed? -%}
      {%- if recommendations.products_count > 0 -%}
        {% render 'section-header', heading: heading, align: 'start', class: 'mb-8' %}
        <ul
          class="{{ list_class }}"
          style="--columns: {{ columns }}; --columns-md: {{ columns_md }};"
          role="list"
          data-scroll-region
          aria-label="{{ heading | escape }}"
        >
          {%- for recommended in recommendations.products -%}
            <li class="{{ item_class }}" data-recommendation-item>
              {% render 'product-card',
                product: recommended,
                sizes: sizes,
                full_width: full_width,
                event_context: 'recommendation'
              %}
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="rounded-lg border border-dashed border-border-strong px-6 py-8 text-center text-body text-foreground/80">
          {{ 'sections.product_recommendations.empty_editor' | t }}
        </p>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Scheletro: titolo e prima riga di card, così l'arrivo dei consigli non sposta la pagina {%- endcomment -%}
      <div class="flex flex-col gap-8" aria-hidden="true">
        <div class="skeleton h-8 w-64 max-w-full rounded-sm"></div>
        <div
          class="{{ list_class }} overflow-hidden"
          style="--columns: {{ columns }}; --columns-md: {{ columns_md }};"
        >
          {%- for i in (1..columns) -%}
            <div class="{{ item_class }} flex flex-col gap-3{% if forloop.index > columns_md %} max-lg:hidden{% endif %}">
              <div class="skeleton aspect-4/5 rounded-lg"></div>
              <div class="skeleton h-4 w-3/4 rounded-sm"></div>
              <div class="skeleton h-4 w-1/3 rounded-sm"></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.product_recommendations.settings.section_width.label",
      "info": "t:sections.product_recommendations.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.product_recommendations.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.product_recommendations.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "paragraph",
      "content": "t:sections.product_recommendations.settings.paragraph_1.content"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product_recommendations.settings.intent.label",
      "options": [
        {
          "value": "related",
          "label": "t:sections.product_recommendations.settings.intent.options.related"
        },
        {
          "value": "complementary",
          "label": "t:sections.product_recommendations.settings.intent.options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.settings.heading.label",
      "info": "t:sections.product_recommendations.settings.heading.info"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.product_recommendations.settings.limit.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.product_recommendations.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.product_recommendations.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.product_recommendations.settings.color_scheme.label",
      "info": "t:sections.product_recommendations.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.presets.preset_1.name"
    }
  ]
}
{% endschema %}
