{%- comment -%}
  Pagina carrello (templates/cart.json).
  Articoli (snippets/cart-line-items) e riepilogo (snippets/cart-summary), condivisi con il carrello a cassetto.
  Funziona senza JS (form verso routes.cart_url: "Aggiorna carrello" e "Checkout").
  JS: frontend/entrypoints/cart.js (<cart-items>): quantità e rimozioni senza ricaricare la pagina.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'vite-tag', entry: 'cart.js' %}

<div class="page-width py-8 md:py-12">
  <p class="sr-only" aria-live="polite" data-cart-status data-updated="{{ 'sections.cart.updated' | t | escape }}"></p>

  {%- comment -%}
    Standard event shopify:cart:view (Shopify) al caricamento della pagina. <s-view-event> sta fuori da
    <cart-items> perché il contenuto di <cart-items> viene sostituito a ogni modifica (eventi duplicati).
  {%- endcomment -%}
  <s-view-event class="contents" view-event-payload='{{ cart | standard_event_data: "view", context: "page" | escape }}'>
  <cart-items class="block" data-section-id="{{ section.id }}">
    {%- if cart.item_count > 0 -%}
      <h1 class="mb-8 text-heading text-headings outline-none md:text-title-page" tabindex="-1" data-cart-focus>{{ 'sections.cart.title' | t }}</h1>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-16">
        <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" novalidate>
          {% render 'cart-line-items', section_id: section.id, image_size: 96 %}
        </form>

        <div class="rounded-lg border border-border bg-surface p-6 lg:sticky lg:top-8 lg:self-start">
          {% render 'cart-free-shipping', section_id: section.id, class: 'mb-6 border-b border-border pb-6' %}
          {% render 'cart-summary',
            section_id: section.id,
            show_note: section.settings.show_note,
            show_dynamic_checkout: section.settings.show_dynamic_checkout,
            show_discount: section.settings.show_discount
          %}
        </div>
      </div>
    {%- else -%}
      <div class="flex flex-col items-center gap-6 py-16 text-center">
        <h1 class="text-heading text-headings outline-none md:text-title-page" tabindex="-1" data-cart-focus>{{ 'sections.cart.empty' | t }}</h1>
        <a href="{{ routes.all_products_collection_url }}" class="button button-primary">
          {{- 'sections.cart.continue_shopping' | t -}}
        </a>
      </div>
    {%- endif -%}
  </cart-items>
  </s-view-event>
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "section-main-cart",
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:sections.main_cart.settings.show_note.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.main_cart.settings.show_dynamic_checkout.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "t:sections.main_cart.settings.show_discount.label",
      "info": "t:sections.main_cart.settings.show_discount.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_cart.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_cart.settings.color_scheme.label",
      "info": "t:sections.main_cart.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
