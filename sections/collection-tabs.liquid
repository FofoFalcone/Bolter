{%- comment -%}
  Collezioni in tab: ogni blocco è una tab con i prodotti di una collezione.
  Basata sull'esempio Motion "Tab select" (https://motion.dev/examples/js-tab-select),
  con pattern ARIA tabs e indicatore animato con motion/mini.
  Senza JS: tutte le collezioni visibili una sotto l'altra, ognuna con il proprio titolo.
  JS: frontend/entrypoints/collection-tabs.js — CSS: frontend/entrypoints/collection-tabs.css
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{% render 'inline-css', entry: 'collection-tabs.css' %}

{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign full_width = false
  if section.settings.section_width == 'full'
    assign page_max = '100vw'
    assign full_width = true
  endif
  assign products_to_show = section.settings.products_to_show
  assign columns = section.settings.columns_desktop
  comment
    Larghezza reale delle card: margini della pagina (2 × 1.5rem) e spazi della griglia (gap-x-4 su mobile, gap-x-6 da
    750px) tolti. Prima 50vw / 33vw: a 412px 206 invece di 174px, che con DPR 3 scaricava 800 invece di 600.
  endcomment
  assign desktop_gaps = columns | minus: 1 | times: 1.5
  assign sizes = '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 3rem - ' | append: desktop_gaps | append: 'rem) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 6rem) / 3), calc((100vw - 4rem) / 2)'

  # Titoli senza salti: con il titolo della section (h2) le tab sono h3 e le card h4, altrimenti h2 e h3
  if section.settings.heading != blank
    assign panel_heading_tag = 'h3'
    assign card_heading_tag = 'h4'
  else
    assign panel_heading_tag = 'h2'
    assign card_heading_tag = 'h3'
  endif
  assign default_tab_label = 'sections.collection_tabs.default_tab_label' | t
  assign tablist_label = 'sections.collection_tabs.tablist_label' | t
  if section.settings.heading != blank
    assign tablist_label = section.settings.heading
  endif

  # Nel negozio pubblicato solo le tab con una collezione che ha prodotti: niente prodotti segnaposto
  # (link "#", prezzi di esempio) indicizzati da Google. Nel theme editor tutte, con le card segnaposto.
  assign visible_count = 0
  for block in section.blocks
    if request.design_mode or block.settings.collection.products_count > 0
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 -%}
<div class="page-width py-8 md:py-16" style="--collection-tabs-columns: {{ columns }};">
  {% render 'section-header', heading: section.settings.heading, class: 'mb-6 md:mb-8' %}

  {%- if visible_count > 0 -%}
    <collection-tabs class="flex flex-col gap-12 js:gap-0">
      {%- if visible_count > 1 -%}
        {%- comment -%}
          SDS "Tabs": etichette Body, bordo inferiore neutral-subtle; la tab attiva ha testo e bordo neutral.
          Il bordo della tab attiva è l'indicatore animato (Motion). Visibili solo con JS: senza JS tutte le collezioni sono in pagina.
        {%- endcomment -%}
        <div
          class="collection-tabs__tablist relative mx-auto mb-8 hidden max-w-full overflow-x-auto border-b border-neutral-subtle [scrollbar-width:none] js:flex"
          role="tablist"
          aria-label="{{ tablist_label | escape }}"
        >
          <span
            class="collection-tabs__indicator pointer-events-none absolute bottom-0 left-0 h-0.5 w-0 bg-neutral"
            aria-hidden="true"
          ></span>
          {%- assign first_tab = true -%}
          {%- for block in section.blocks -%}
            {%- unless request.design_mode or block.settings.collection.products_count > 0 -%}
              {%- continue -%}
            {%- endunless -%}
            {%- assign label = block.settings.label | default: block.settings.collection.title -%}
            <button
              type="button"
              role="tab"
              class="collection-tabs__tab shrink-0 rounded-t-sm px-3 py-1 text-body whitespace-nowrap text-neutral-muted transition-colors hover:text-neutral focus-visible:outline-offset-[-2px] aria-selected:text-neutral"
              id="CollectionTab-{{ block.id }}"
              aria-controls="CollectionPanel-{{ block.id }}"
              aria-selected="{{ first_tab }}"
              tabindex="{% if first_tab %}0{% else %}-1{% endif %}"
            >
              {{- label | default: default_tab_label | escape -}}
            </button>
            {%- assign first_tab = false -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign first_panel = true -%}
      {%- for block in section.blocks -%}
        {%- unless request.design_mode or block.settings.collection.products_count > 0 -%}
          {%- continue -%}
        {%- endunless -%}
        {%- liquid
          assign collection = block.settings.collection
          assign label = block.settings.label | default: collection.title | default: default_tab_label
        -%}
        <div
          class="collection-tabs__panel rounded-md focus-visible:outline-offset-4"
          id="CollectionPanel-{{ block.id }}"
          {% if visible_count > 1 %}
            role="tabpanel"
            aria-labelledby="CollectionTab-{{ block.id }}"
            tabindex="0"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Con le tab il titolo del pannello serve solo agli screen reader {%- endcomment -%}
          <{{ panel_heading_tag }} class="mb-4 text-heading text-headings{% if visible_count > 1 %} js:sr-only{% endif %}">
            {{- label | escape -}}
          </{{ panel_heading_tag }}>

          <ul
            class="collection-tabs__grid grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-3 md:gap-x-6 md:gap-y-8 lg:grid-cols-[repeat(var(--collection-tabs-columns),minmax(0,1fr))]"
            role="list"
          >
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: products_to_show -%}
                {%- liquid
                  # card_id: lo stesso prodotto può comparire in più tab
                  assign card_id = block.id | append: '-' | append: product.id
                  # Prima section della pagina: le card della prima tab sono sopra la piega (prima = probabile LCP)
                  assign loading = 'lazy'
                  assign fetchpriority = 'auto'
                  if section.index == 1 and first_panel
                    assign loading = 'eager'
                    if forloop.first
                      assign fetchpriority = 'high'
                    endif
                  endif
                -%}
                <li class="collection-tabs__item"{% if first_panel %} data-animate-scroll="fade-up"{% endif %}>
                  {% render 'product-card',
                    product: product,
                    card_id: card_id,
                    heading_tag: card_heading_tag,
                    sizes: sizes,
                    full_width: full_width,
                    loading: loading,
                    fetchpriority: fetchpriority,
                    link_collection: collection
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} Solo nel theme editor (le tab senza prodotti non si stampano nel negozio) {%- endcomment -%}
              {%- for i in (1..products_to_show) -%}
                <li class="collection-tabs__item">
                  {% render 'product-card', product: blank, heading_tag: card_heading_tag, sizes: sizes %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>

          {%- if section.settings.show_view_all and collection != blank -%}
            <div class="mt-8 flex justify-center">
              <a class="button button-neutral" href="{{ collection.url }}">
                {{- 'sections.collection_tabs.view_all' | t -}}
                <span class="sr-only">: {{ label | escape }}</span>
                {% render 'icon', name: 'arrow-right', size: 16 %}
              </a>
            </div>
          {%- endif -%}
        </div>
        {%- assign first_panel = false -%}
      {%- endfor -%}
    </collection-tabs>
  {%- endif -%}
</div>

{% render 'vite-tag-deferred', entry: 'collection-tabs.js', section_index: section.index %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_tabs.name",
  "tag": "section",
  "class": "section-collection-tabs",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.collection_tabs.settings.section_width.label",
      "info": "t:sections.collection_tabs.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.collection_tabs.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.collection_tabs.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_tabs.settings.heading.label",
      "default": "t:sections.collection_tabs.settings.heading.default"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.collection_tabs.settings.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.collection_tabs.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.collection_tabs.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection_tabs.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_tabs.settings.color_scheme.label",
      "info": "t:sections.collection_tabs.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_tabs.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_tabs.blocks.collection.settings.collection.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.collection_tabs.blocks.collection.settings.label.label",
          "info": "t:sections.collection_tabs.blocks.collection.settings.label.info"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.collection_tabs.presets.preset_1.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "label": "t:sections.collection_tabs.presets.preset_1.blocks.block_1.label"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "t:sections.collection_tabs.presets.preset_1.blocks.block_2.label"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "t:sections.collection_tabs.presets.preset_1.blocks.block_3.label"
          }
        }
      ]
    }
  ]
}
{% endschema %}
