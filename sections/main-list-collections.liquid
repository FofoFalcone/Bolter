{%- comment -%}
  Elenco delle collezioni (templates/list-collections.json, URL /collections): titolo, griglia di card e paginazione.
  Ordine: quello scelto nelle impostazioni, oppure quello di un menu (l'unico modo per un ordine su misura, secondo la
  documentazione Shopify); con il menu niente paginazione, compaiono solo le collezioni che contiene.
  Prima riga eager, prima immagine LCP se la section è la prima della pagina. Above the fold: niente data-animate.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign s = section.settings
  assign use_menu = false
  if s.menu.links.size > 0
    assign use_menu = true
  endif

  case s.image_ratio
    when 'portrait'
      assign ratio_class = 'aspect-3/4'
    when 'landscape'
      assign ratio_class = 'aspect-4/3'
    else
      assign ratio_class = 'aspect-square'
  endcase

  assign columns = s.columns_desktop
  assign columns_md = columns | at_most: 3
  if s.columns_mobile == '1'
    assign columns_mobile_class = 'grid-cols-1'
    assign columns_mobile = 1
  else
    assign columns_mobile_class = 'grid-cols-2'
    assign columns_mobile = 2
  endif
  capture sizes
    echo '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 4rem) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 4rem) / ' | append: columns_md | append: '), calc((100vw - 2rem) / ' | append: columns_mobile | append: ')'
  endcapture

  assign above_fold = false
  if section.index == 1
    assign above_fold = true
  endif

  case s.sort
    when 'products_high', 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date', 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase
  if s.sort == 'products_high' or s.sort == 'date_reversed' or s.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif
-%}
{%- capture grid_class -%}
  grid {{ columns_mobile_class }} gap-x-4 gap-y-8 md:grid-cols-[repeat(var(--columns-md),minmax(0,1fr))] md:gap-x-6 md:gap-y-10 lg:grid-cols-[repeat(var(--columns),minmax(0,1fr))]
{%- endcapture -%}

<div class="page-width flex flex-col gap-8 py-12 md:gap-12 md:py-16">
  <h1 class="text-heading text-balance text-headings md:text-title-page">
    {{- s.heading | default: page_title | escape -}}
  </h1>

  {%- if use_menu -%}
    <ul class="{{ grid_class }}" style="--columns: {{ columns }}; --columns-md: {{ columns_md }};" role="list">
      {%- assign position = 0 -%}
      {%- for link in s.menu.links -%}
        {%- if link.type == 'collection_link' -%}
          {%- liquid
            assign position = position | plus: 1
            assign card_loading = 'lazy'
            assign card_priority = 'auto'
            if above_fold and position <= columns
              assign card_loading = 'eager'
              if position == 1
                assign card_priority = 'high'
              endif
            endif
          -%}
          <li>
            {% render 'collection-card',
              collection: link.object,
              ratio_class: ratio_class,
              sizes: sizes,
              show_count: s.show_count,
              loading: card_loading,
              fetchpriority: card_priority
            %}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- else -%}
    {%- paginate collections by s.per_page -%}
      {%- if collections.size > 0 -%}
        <ul class="{{ grid_class }}" style="--columns: {{ columns }}; --columns-md: {{ columns_md }};" role="list">
          {%- for collection in collections -%}
            {%- liquid
              assign card_loading = 'lazy'
              assign card_priority = 'auto'
              if above_fold and paginate.current_page == 1 and forloop.index <= columns
                assign card_loading = 'eager'
                if forloop.first
                  assign card_priority = 'high'
                endif
              endif
            -%}
            <li>
              {% render 'collection-card',
                collection: collection,
                ratio_class: ratio_class,
                sizes: sizes,
                show_count: s.show_count,
                loading: card_loading,
                fetchpriority: card_priority
              %}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="flex flex-col items-center gap-4 rounded-lg bg-surface px-6 py-16 text-center">
          <h2 class="text-heading text-balance text-headings">{{ 'sections.list_collections.empty_title' | t }}</h2>
          <p class="max-w-xl text-body text-pretty text-foreground/80">{{ 'sections.list_collections.empty_text' | t }}</p>
          <a href="{{ routes.root_url }}" class="button button-primary">{{ 'general.404.home' | t }}</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "class": "section-main-list-collections",
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_list_collections.settings.heading.label",
      "default": "t:sections.main_list_collections.settings.heading.default"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_list_collections.settings.sort.label",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main_list_collections.settings.sort.options.alphabetical"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main_list_collections.settings.sort.options.alphabetical_reversed"
        },
        {
          "value": "products_high",
          "label": "t:sections.main_list_collections.settings.sort.options.products_high"
        },
        {
          "value": "products_low",
          "label": "t:sections.main_list_collections.settings.sort.options.products_low"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main_list_collections.settings.sort.options.date_reversed"
        },
        {
          "value": "date",
          "label": "t:sections.main_list_collections.settings.sort.options.date"
        }
      ],
      "default": "alphabetical"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.main_list_collections.settings.menu.label",
      "info": "t:sections.main_list_collections.settings.menu.info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main_list_collections.settings.image_ratio.label",
      "options": [
        {
          "value": "square",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.main_list_collections.settings.image_ratio.options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main_list_collections.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_list_collections.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_list_collections.settings.columns_mobile.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.main_list_collections.settings.columns_mobile.options.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.main_list_collections.settings.show_count.label",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.main_list_collections.settings.per_page.label",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "t:sections.main_list_collections.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_list_collections.settings.color_scheme.label",
      "info": "t:sections.main_list_collections.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
