{%- comment -%}
  Pagina collezione (templates/collection.json): intestazione, filtri Search & Discovery, ordinamento, griglia
  di card prodotto e paginazione.

  - Senza JS tutto funziona con form GET e link (filtri, ordinamento, chip dei filtri attivi, pagine).
  - Con JS (frontend/entrypoints/collection.js, <product-facets>): filtri e ordinamento aggiornano i risultati
    senza ricaricare la pagina (Section Rendering API), con URL condivisibile e senza voci nella cronologia;
    lo standard event shopify:collection:update parte a ogni modifica. Anteprima rapida al clic sulla card.
  - Standard events: shopify:collection:view (intestazione, fuori dalle parti aggiornate: un solo evento),
    shopify:product:view sulle card (snippets/product-card.liquid, contesto "collection").
  - Filtri: snippets/facets-panel.liquid (cassetto sotto i 990px, barra laterale o barra orizzontale da 990px),
    snippets/facets-active.liquid (chip), paginazione: snippets/pagination.liquid.
  CSS: frontend/entrypoints/collection.css (cassetto dei filtri), in fondo alla section: un <link> nel body blocca
  il rendering di ciò che segue, e il cassetto all'apertura della pagina è chiuso.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{% render 'vite-tag', entry: 'collection.js' %}

{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign full_width = false
  if section.settings.section_width == 'full'
    assign page_max = '100vw'
    assign full_width = true
  endif
  # A tutta larghezza servono formati più grandi; su "Pagina" restano fuori, così non si scaricano per sbaglio
  assign image_max = 1600
  assign image_widths = '400, 600, 800, 1000, 1200, 1600'
  if full_width
    assign image_max = 2600
    assign image_widths = image_widths | append: ', 2000, 2600'
  endif
  assign s = section.settings

  assign show_filters = false
  if s.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif
  assign sidebar = false
  if show_filters and s.filter_layout == 'sidebar'
    assign sidebar = true
  endif
  assign toolbar = false
  if show_filters and s.filter_layout == 'toolbar'
    assign toolbar = true
  endif

  # Ordinamento attuale e URL "senza filtri" (mantiene l'ordinamento scelto)
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url
  if collection.sort_by != blank
    assign clear_url = clear_url | append: '?sort_by=' | append: collection.sort_by
  endif

  # Filtri attivi (badge del pulsante "Filtri" sotto i 990px)
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  # Colonne: tablet al massimo 3; da 990px con la barra laterale al massimo 3, tutte da 1280px
  assign columns = s.columns_desktop
  assign columns_md = columns | at_most: 3
  assign columns_lg = columns
  if sidebar
    assign columns_lg = columns | at_most: 3
  endif
  if s.columns_mobile == '1'
    assign columns_mobile_class = 'grid-cols-1'
    assign columns_mobile = 1
  else
    assign columns_mobile_class = 'grid-cols-2'
    assign columns_mobile = 2
  endif
  capture sizes
    echo '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 4rem'
    if sidebar
      echo ' - 18rem'
    endif
    # Sotto i 750px: margini della pagina (2 × 1,5rem) e spazio tra le colonne (1rem). Con "100vw - 2rem" la card
    # risultava 16px più larga del vero e il telefono di Lighthouse mobile scaricava un formato in più (2026-11-11)
    if columns_mobile == 1
      echo ') / ' | append: columns_lg | append: '), (min-width: 750px) calc((100vw - 4rem) / ' | append: columns_md | append: '), calc(100vw - 3rem)'
    else
      echo ') / ' | append: columns_lg | append: '), (min-width: 750px) calc((100vw - 4rem) / ' | append: columns_md | append: '), calc((100vw - 4rem) / 2)'
    endif
  endcapture

  # LCP: immagine della collezione se mostrata, altrimenti la prima card (solo se la section è la prima della pagina)
  assign show_image = false
  if s.show_image and collection.image
    assign show_image = true
  endif
  assign above_fold = false
  if section.index == 1
    assign above_fold = true
  endif

  assign quick_view_id = 'QuickView-' | append: section.id
  assign panel_id = 'FacetsPanel-' | append: section.id
-%}

<div class="page-width py-8 md:py-12">
  {%- comment -%}
    Standard event shopify:collection:view all'apertura della pagina. Avvolge solo l'intestazione: le parti
    sostituite dai filtri non devono ricrearlo (l'elemento emette l'evento a ogni inserimento nella pagina).
  {%- endcomment -%}
  <s-view-event class="block" view-event-payload='{{ collection | standard_event_data: "view" | escape }}'>
    <header class="grid gap-6{% if show_image %} md:grid-cols-2 md:items-center md:gap-12{% endif %}">
      <div class="flex flex-col gap-4">
        <h1 class="text-heading text-balance text-headings md:text-title-page">{{ collection.title | escape }}</h1>
        {%- if s.show_description and collection.description != blank -%}
          <div class="prose prose-theme max-w-2xl text-pretty">{{ collection.description }}</div>
        {%- endif -%}
      </div>
      {%- if show_image -%}
        <div class="aspect-16/9 overflow-hidden rounded-lg bg-surface md:aspect-4/3">
          {%- liquid
            assign image_alt = collection.image.alt | default: collection.title
            assign image_loading = 'lazy'
            assign image_priority = 'auto'
            if above_fold
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endif
          -%}
          {{
            collection.image
            | image_url: width: image_max
            | image_tag:
              loading: image_loading,
              fetchpriority: image_priority,
              alt: image_alt,
              widths: image_widths,
              sizes: '(min-width: 750px) 50vw, 100vw',
              class: 'size-full object-cover'
          }}
        </div>
      {%- endif -%}
    </header>
  </s-view-event>

  {%- paginate collection.products by s.products_per_page -%}
    <product-facets
      class="mt-8 block md:mt-12"
      data-section-id="{{ section.id }}"
      data-layout="{% if toolbar %}toolbar{% else %}sidebar{% endif %}"
      data-collection-handle="{{ collection.handle }}"
      data-collection-count="{{ collection.all_products_count }}"
      {% if collection.id %}
        data-collection-gid="gid://shopify/Collection/{{ collection.id }}"
      {% endif %}
      {% if s.quick_view %}
        data-quick-view="{{ quick_view_id }}"
      {% endif %}
    >
      <div class="{% if sidebar %}lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start lg:gap-12{% endif %}">
        {%- if show_filters -%}
          {% render 'facets-panel',
            results: collection,
            results_count: collection.products_count,
            section_id: section.id,
            layout: s.filter_layout,
            action: collection.url,
            clear_url: clear_url,
            sort_by: collection.sort_by
          %}
        {%- endif -%}

        <div class="flex min-w-0 flex-col gap-6{% if toolbar %} lg:mt-6{% endif %}">
          <div class="flex flex-wrap items-center gap-3">
            {%- if show_filters -%}
              <button
                type="button"
                id="FacetsOpen-{{ section.id }}"
                class="button button-neutral button-sm lg:hidden"
                popovertarget="{{ panel_id }}"
                data-facets-part="drawer-button"
              >
                {% render 'icon', name: 'adjustments-horizontal', class: 'size-5' %}
                {{ 'sections.collection.filters' | t }}
                {%- if active_count > 0 -%}
                  <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-body-sm leading-5 text-primary-foreground tabular-nums" aria-hidden="true">
                    {{- active_count -}}
                  </span>
                  <span class="sr-only">({{ 'sections.collection.selected_count' | t: count: active_count }})</span>
                {%- endif -%}
              </button>
            {%- endif -%}

            {%- comment -%} tabindex -1: riceve il focus quando il chip usato sparisce (collection.js) {%- endcomment -%}
            <p class="me-auto text-body-sm text-muted tabular-nums outline-none" tabindex="-1" data-facets-part="count">
              {{- 'sections.collection.products_count' | t: count: collection.products_count -}}
            </p>

            {%- if s.enable_sorting and collection.sort_options.size > 0 -%}
              {%- comment -%}
                Form a parte: funziona anche senza filtri. Senza JS mantiene i filtri attivi con campi nascosti;
                con JS <product-facets> legge solo la select.
              {%- endcomment -%}
              <form action="{{ collection.url }}" method="get" class="flex items-center gap-2" data-facets-sort-form>
                {%- for filter in collection.filters -%}
                  {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value != nil -%}
                      <input type="hidden" name="{{ filter.min_value.param_name }}" value="{% render 'facets-price-value', amount: filter.min_value.value %}">
                    {%- endif -%}
                    {%- if filter.max_value.value != nil -%}
                      <input type="hidden" name="{{ filter.max_value.param_name }}" value="{% render 'facets-price-value', amount: filter.max_value.value %}">
                    {%- endif -%}
                  {%- else -%}
                    {%- for filter_value in filter.active_values -%}
                      <input type="hidden" name="{{ filter_value.param_name }}" value="{{ filter_value.value | escape }}">
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
                <label for="SortBy-{{ section.id }}" class="text-body-sm text-muted max-md:sr-only">
                  {{- 'sections.collection.sort_by' | t -}}
                </label>
                <div class="relative">
                  <select
                    id="SortBy-{{ section.id }}"
                    name="sort_by"
                    class="h-9 cursor-pointer appearance-none rounded-button border border-input-border bg-input ps-3 pe-9 text-body-sm text-input-foreground transition-colors duration-150 hover:border-input-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary motion-reduce:transition-none"
                    data-facets-sort
                    data-default="{{ collection.default_sort_by | escape }}"
                  >
                    {%- for option in collection.sort_options -%}
                      <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                        {{- option.name | escape -}}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon', name: 'chevron-down', class: 'pointer-events-none absolute inset-y-0 end-2.5 my-auto size-4 text-input-foreground/65' %}
                </div>
                <button type="submit" class="button button-neutral button-sm js:hidden">{{ 'sections.collection.apply' | t }}</button>
              </form>
            {%- endif -%}
          </div>

          {%- if show_filters -%}
            <div data-facets-part="active" class="[&:not(:has(*))]:hidden">
              {%- render 'facets-active', results: collection, clear_url: clear_url, show_filter_label: s.show_filter_label -%}
            </div>
          {%- endif -%}

          <div
            id="ProductGrid-{{ section.id }}"
            class="scroll-mt-[calc(var(--header-height)+1rem)] transition-opacity duration-200 aria-busy:opacity-50 motion-reduce:transition-none"
            data-facets-part="results"
            data-facets-results
            data-products-count="{{ collection.products_count }}"
          >
            <h2 class="sr-only">{{ 'sections.collection.results_heading' | t }}</h2>
            {%- capture grid_attributes -%}
              class="grid {{ columns_mobile_class }} gap-x-4 gap-y-8 md:grid-cols-[repeat(var(--columns-md),minmax(0,1fr))] md:gap-x-6 lg:grid-cols-[repeat(var(--columns-lg),minmax(0,1fr))]{% if sidebar %} xl:grid-cols-[repeat(var(--columns),minmax(0,1fr))]{% endif %}"
              style="--columns: {{ columns }}; --columns-md: {{ columns_md }}; --columns-lg: {{ columns_lg }};"
              role="list"
            {%- endcapture -%}

            {%- if collection.products_count > 0 -%}
              <ul {{ grid_attributes }}>
                {%- for product in collection.products -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign fetchpriority = 'auto'
                    if above_fold and paginate.current_page == 1 and forloop.index <= columns_lg
                      assign loading = 'eager'
                      if forloop.first and show_image == false
                        assign fetchpriority = 'high'
                      endif
                    endif
                  -%}
                  <li>
                    {% render 'product-card',
                      product: product,
                      sizes: sizes,
                      full_width: full_width,
                      loading: loading,
                      fetchpriority: fetchpriority,
                      event_context: 'collection',
                      quick_view: s.quick_view
                    %}
                  </li>
                {%- endfor -%}
              </ul>

            {%- elsif collection.all_products_count > 0 -%}
              {%- comment -%} Nessun risultato con i filtri scelti {%- endcomment -%}
              <div class="flex flex-col items-center gap-4 rounded-lg border border-dashed border-border-strong px-6 py-16 text-center">
                {% render 'icon', name: 'adjustments-horizontal', class: 'size-8 text-subtle' %}
                <p class="text-subheading text-balance text-foreground">{{ 'sections.collection.no_results_title' | t }}</p>
                <p class="max-w-md text-body text-pretty text-muted">{{ 'sections.collection.no_results_text' | t }}</p>
                <a href="{{ clear_url }}" class="button button-neutral" data-facets-link>{{ 'sections.collection.clear_filters' | t }}</a>
              </div>

            {%- elsif request.design_mode -%}
              {%- comment -%} Theme editor, collezione vuota: card segnaposto per valutare la griglia {%- endcomment -%}
              <ul {{ grid_attributes }}>
                {%- for i in (1..columns) -%}
                  <li>{% render 'product-card', product: blank, sizes: sizes %}</li>
                {%- endfor -%}
              </ul>

            {%- else -%}
              <div class="flex flex-col items-center gap-4 rounded-lg bg-surface px-6 py-16 text-center">
                <p class="text-subheading text-balance text-foreground">{{ 'sections.collection.empty_title' | t }}</p>
                <p class="max-w-md text-body text-pretty text-foreground/80">{{ 'sections.collection.empty_text' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="button button-primary">
                  {{- 'sections.collection.continue_shopping' | t -}}
                </a>
              </div>
            {%- endif -%}
          </div>

          <div data-facets-part="pagination" class="[&:not(:has(*))]:hidden">
            {%- render 'pagination', paginate: paginate -%}
          </div>
        </div>
      </div>
    </product-facets>
  {%- endpaginate -%}

  <p class="sr-only" aria-live="polite" data-facets-status></p>
</div>

{%- if s.quick_view -%}
  {% render 'quick-view', id: quick_view_id, when: 'idle' %}
{%- endif -%}

{% render 'inline-css', entry: 'collection.css' %}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "class": "section-main-collection",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.main_collection.settings.section_width.label",
      "info": "t:sections.main_collection.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.main_collection.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.main_collection.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header_1.content"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_collection.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_collection.settings.show_image.label",
      "info": "t:sections.main_collection.settings.show_image.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header_2.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.settings.products_per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main_collection.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_mobile.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_mobile.options.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "quick_view",
      "label": "t:sections.main_collection.settings.quick_view.label",
      "info": "t:sections.main_collection.settings.quick_view.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header_3.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_collection.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:sections.main_collection.settings.filter_layout.label",
      "info": "t:sections.main_collection.settings.filter_layout.info",
      "options": [
        {
          "value": "sidebar",
          "label": "t:sections.main_collection.settings.filter_layout.options.sidebar"
        },
        {
          "value": "toolbar",
          "label": "t:sections.main_collection.settings.filter_layout.options.toolbar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_label",
      "label": "t:sections.main_collection.settings.show_filter_label.label",
      "info": "t:sections.main_collection.settings.show_filter_label.info",
      "default": false,
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header_4.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_collection.settings.color_scheme.label",
      "info": "t:sections.main_collection.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
