{%- comment -%}
  Collage: immagini sovrapposte e ruotate (fino a 4) con adesivi (fino a 2), accanto a titolo, testo e pulsante.
  Tendenze "collage" e "massimalismo": composizioni predefinite (setting `arrangement`) invece di coordinate libere,
  così il merchant sceglie solo le immagini e il risultato resta curato a ogni larghezza (posizioni in percentuale
  su un palco quadrato, adesivi dimensionati in cqw sul palco).

  Struttura di una tessera: <li> posizionato e ruotato (--r; ingresso data-animate-stagger, che scrive `translate`
  inline) > contenitore della parallasse (collage__drift: `translate` guidato dallo scroll in CSS, su un elemento
  diverso per non scontrarsi con l'ingresso) > immagine. All'hover la tessera si raddrizza e passa davanti.
  Adesivo tondo: testo su un cerchio (SVG textPath) che ruota con lo scroll, non da solo: niente movimento continuo
  da mettere in pausa (WCAG 2.2.2). Animazioni di scroll solo CSS (animation-timeline: view(), fuori dal main
  thread) in frontend/entrypoints/collage.css: dove non sono supportate o con movimento ridotto, collage statico.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  assign s = section.settings
  assign image_blocks = section.blocks | where: 'type', 'image'
  assign sticker_blocks = section.blocks | where: 'type', 'sticker'

  # Base dei sizes: non accetta var() (snippets/section-width.liquid). Una tessera è circa il 30% della pagina da
  # 750px (palco = metà pagina, tessera fino al 56% del palco) e il 60% dello schermo sotto.
  assign page_max = settings.layout_page_width | append: 'px'
  if s.section_width == 'full'
    assign page_max = '100vw'
  endif
  assign image_sizes = '(min-width: 750px) calc(min(100vw, ' | append: page_max | append: ') * 0.3), 60vw'

  assign animate = true
  if section.index == 1 or request.visual_preview_mode
    assign animate = false
  endif

  if s.frame == 'polaroid'
    assign frame_class = 'bg-white p-[3cqw] pb-[9cqw]'
  else
    assign frame_class = ''
  endif
-%}

<div class="page-width py-8 md:py-16">
  <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
    <div
      class="flex flex-col items-start gap-6{% if s.text_position == 'end' %} md:order-last{% endif %}"
      {% if animate %}
        data-animate="fade-up"
      {% endif %}
    >
      {%- if s.heading != blank -%}
        <h2 class="text-title-page text-headings md:text-title-hero">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="prose prose-theme max-w-2xl text-subheading">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a class="button button-primary button-lg" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>

    <ul
      class="@container relative aspect-square w-full"
      role="list"
      {% if animate %}
        data-animate-stagger="fade-up"
      {% endif %}
    >
      {%- for block in image_blocks -%}
        {%- liquid
          # Posizione (x, y), larghezza e rotazione di ogni tessera per composizione, nell'ordine dei blocchi. Variabili
          # inline lette da 4 classi fisse: con classi arbitrarie per ogni combinazione (circa 30) il CSS globale,
          # caricato su tutte le pagine, cresceva di 2,5 kB per una sola section.
          case s.arrangement
            when 'stack'
              assign layout = '22%,15%,56%,-9deg|22%,15%,56%,-3deg|22%,15%,56%,3deg|22%,15%,56%,9deg'
            when 'cascade'
              assign layout = '0%,0%,44%,-3deg|26%,15%,44%,2deg|52%,30%,44%,-2deg|8%,62%,30%,4deg'
            else
              assign layout = '2%,4%,50%,-5deg|48%,0%,42%,4deg|34%,40%,44%,-2deg|4%,62%,30%,6deg'
          endcase
          assign tile_index = forloop.index0 | at_most: 3
          assign tile = layout | split: '|' | slice: tile_index | first | split: ','

          # Parallasse: ogni tessera scorre di una quantità diversa (in collage.css)
          assign drift = '-24px|32px|-12px|20px' | split: '|' | slice: tile_index | first

          assign loading = 'lazy'
          assign fetchpriority = 'auto'
          if section.index == 1 and forloop.first
            assign loading = 'eager'
            assign fetchpriority = 'high'
          endif
        -%}
        {%- if block.settings.image != blank or request.design_mode -%}
          <li
            class="absolute top-(--y) left-(--x) z-(--z) w-(--w) rotate-(--r) transition-[rotate,scale] duration-500 ease-theme hover:z-10 motion-safe:hover:scale-[1.03] motion-safe:hover:rotate-0{% if s.arrangement == 'stack' %} origin-bottom{% endif %}"
            style="--x: {{ tile[0] }}; --y: {{ tile[1] }}; --w: {{ tile[2] }}; --r: {{ tile[3] }}; --z: {{ forloop.index }};"
            {{ block.shopify_attributes }}
          >
            <div class="collage__drift" style="--drift: {{ drift }};">
              <div class="rounded-lg shadow-400 {{ frame_class }}">
                <div class="media-loading relative aspect-4/5 overflow-hidden rounded-md bg-surface">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1000
                      | image_tag:
                        loading: loading,
                        fetchpriority: fetchpriority,
                        widths: '300, 450, 600, 800, 1000',
                        sizes: image_sizes,
                        alt: block.settings.image.alt,
                        class: 'absolute inset-0 size-full object-cover'
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'absolute inset-0 size-full fill-subtle' }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in sticker_blocks -%}
        {%- if block.settings.text != blank -%}
          {%- liquid
            if forloop.first
              assign sticker_position = 'right-[3%] top-[3%]'
            else
              assign sticker_position = 'bottom-[3%] left-[38%]'
            endif
            case block.settings.style
              when 'sale'
                assign sticker_colors = 'bg-badge-sale text-badge-sale-foreground'
              when 'contrast'
                assign sticker_colors = 'bg-foreground text-background'
              else
                assign sticker_colors = 'bg-primary text-primary-foreground'
            endcase
          -%}
          <li class="absolute z-20 {{ sticker_position }}" {{ block.shopify_attributes }}>
            {%- if block.settings.shape == 'circle' -%}
              {%- liquid
                assign sticker_text = block.settings.text | upcase | escape
                capture ring_text
                  for i in (1..3)
                    echo sticker_text | append: ' • '
                  endfor
                endcapture
              -%}
              <div class="collage__spin relative size-[26cqw] rounded-full shadow-300 {{ sticker_colors }}">
                <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" aria-hidden="true">
                  <defs>
                    <path id="CollageRing-{{ block.id }}" d="M50,50 m-36,0 a36,36 0 1,1 72,0 a36,36 0 1,1 -72,0"></path>
                  </defs>
                  <text class="font-heading" fill="currentColor" font-size="10.5" font-weight="700" letter-spacing="1">
                    <textPath href="#CollageRing-{{ block.id }}" textLength="226" lengthAdjust="spacing">{{ ring_text }}</textPath>
                  </text>
                </svg>
                <span class="absolute inset-0 m-auto flex size-[30%] items-center justify-center" aria-hidden="true">
                  {% render 'icon', name: 'sparkles', size: 'full' %}
                </span>
                <span class="sr-only">{{ block.settings.text | escape }}</span>
              </div>
            {%- else -%}
              <div class="collage__sway rounded-sm px-[3cqw] py-[1.5cqw] font-heading text-[clamp(0.875rem,4cqw,1.5rem)] font-semibold leading-none uppercase shadow-300 {{ sticker_colors }}">
                {{- block.settings.text | escape -}}
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% render 'inline-css', entry: 'collage.css' %}

{% schema %}
{
  "name": "t:sections.collage.name",
  "tag": "section",
  "class": "section-collage",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.collage.settings.section_width.label",
      "info": "t:sections.collage.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.collage.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.collage.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collage.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.collage.settings.header_1.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collage.settings.heading.label",
      "default": "t:sections.collage.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.collage.settings.text.label",
      "default": "t:sections.collage.settings.text.default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.collage.settings.button_label.label",
      "default": "t:sections.collage.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.collage.settings.button_link.label",
      "info": "t:sections.collage.settings.button_link.info"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "t:sections.collage.settings.text_position.label",
      "info": "t:sections.collage.settings.text_position.info",
      "options": [
        {
          "value": "start",
          "label": "t:sections.collage.settings.text_position.options.start"
        },
        {
          "value": "end",
          "label": "t:sections.collage.settings.text_position.options.end"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "t:sections.collage.settings.header_2.content"
    },
    {
      "type": "select",
      "id": "arrangement",
      "label": "t:sections.collage.settings.arrangement.label",
      "info": "t:sections.collage.settings.arrangement.info",
      "options": [
        {
          "value": "scatter",
          "label": "t:sections.collage.settings.arrangement.options.scatter"
        },
        {
          "value": "stack",
          "label": "t:sections.collage.settings.arrangement.options.stack"
        },
        {
          "value": "cascade",
          "label": "t:sections.collage.settings.arrangement.options.cascade"
        }
      ],
      "default": "scatter"
    },
    {
      "type": "select",
      "id": "frame",
      "label": "t:sections.collage.settings.frame.label",
      "options": [
        {
          "value": "polaroid",
          "label": "t:sections.collage.settings.frame.options.polaroid"
        },
        {
          "value": "none",
          "label": "t:sections.collage.settings.frame.options.none"
        }
      ],
      "default": "polaroid"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.collage.blocks.image.name",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collage.blocks.image.settings.image.label",
          "info": "t:sections.collage.blocks.image.settings.image.info"
        }
      ]
    },
    {
      "type": "sticker",
      "name": "t:sections.collage.blocks.sticker.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.collage.blocks.sticker.settings.text.label",
          "info": "t:sections.collage.blocks.sticker.settings.text.info",
          "default": "t:sections.collage.blocks.sticker.settings.text.default"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "t:sections.collage.blocks.sticker.settings.shape.label",
          "info": "t:sections.collage.blocks.sticker.settings.shape.info",
          "options": [
            {
              "value": "circle",
              "label": "t:sections.collage.blocks.sticker.settings.shape.options.circle"
            },
            {
              "value": "label",
              "label": "t:sections.collage.blocks.sticker.settings.shape.options.label"
            }
          ],
          "default": "circle"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.collage.blocks.sticker.settings.style.label",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.collage.blocks.sticker.settings.style.options.primary"
            },
            {
              "value": "sale",
              "label": "t:sections.collage.blocks.sticker.settings.style.options.sale"
            },
            {
              "value": "contrast",
              "label": "t:sections.collage.blocks.sticker.settings.style.options.contrast"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collage.presets.preset_1.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "sticker"
        },
        {
          "type": "sticker",
          "settings": {
            "text": "t:sections.collage.presets.preset_1.blocks.block_5.text",
            "shape": "label",
            "style": "contrast"
          }
        }
      ]
    }
  ]
}
{% endschema %}
