{%- comment -%}
  Iscrizione alla newsletter: titolo, testo e form 'customer' nativo (snippets/newsletter-form.liquid, condiviso con
  il blocco "Newsletter" del footer). Funziona senza JS; stato di invio con <contact-form>
  (frontend/entrypoints/contact-form.js). Per provare la conferma senza iscriversi: ?customer_posted=true.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{%- liquid
  assign s = section.settings
  assign form_id = 'Newsletter-' | append: section.id
-%}

<div class="page-width py-8 md:py-16">
  <contact-form
    class="mx-auto flex flex-col gap-6 {% if s.layout == 'split' %}text-start lg:grid lg:grid-cols-2 lg:items-center lg:gap-12{% else %}max-w-2xl items-center text-center{% endif %}"
    data-sending-label="{{ 'sections.newsletter.sending' | t | escape }}"
    {% unless section.index == 1 %}
      data-animate="fade-up"
    {% endunless %}
  >
    {%- if s.heading != blank or s.text != blank -%}
      <div class="flex flex-col gap-3">
        {%- if s.heading != blank -%}
          <h2 class="text-heading text-balance text-headings md:text-title-page">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="prose prose-theme max-w-none text-body text-pretty text-foreground/80">
            {{ s.text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% render 'newsletter-form',
      form_id: form_id,
      tags: s.tags,
      button_label: s.button_label,
      success_message: s.success_message,
      consent: s.consent,
      class: 'w-full max-w-lg'
    %}
  </contact-form>
</div>

{% render 'vite-tag-deferred', entry: 'contact-form.js', section_index: section.index %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section-newsletter",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "t:sections.newsletter.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "t:sections.newsletter.settings.text.default"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.newsletter.settings.layout.label",
      "options": [
        {
          "value": "center",
          "label": "t:sections.newsletter.settings.layout.options.center"
        },
        {
          "value": "split",
          "label": "t:sections.newsletter.settings.layout.options.split"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header_1.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label",
      "default": "t:sections.newsletter.settings.button_label.default"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:sections.newsletter.settings.success_message.label",
      "default": "t:sections.newsletter.settings.success_message.default"
    },
    {
      "type": "select",
      "id": "consent",
      "label": "t:sections.newsletter.settings.consent.label",
      "info": "t:sections.newsletter.settings.consent.info",
      "options": [
        {
          "value": "checkbox",
          "label": "t:sections.newsletter.settings.consent.options.checkbox"
        },
        {
          "value": "notice",
          "label": "t:sections.newsletter.settings.consent.options.notice"
        }
      ],
      "default": "checkbox"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "t:sections.newsletter.settings.tags.label",
      "info": "t:sections.newsletter.settings.tags.info",
      "default": "t:sections.newsletter.settings.tags.default"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header_2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "info": "t:sections.newsletter.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.preset_1.name"
    }
  ]
}
{% endschema %}
