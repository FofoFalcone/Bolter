{%- comment -%}
  Elenco di collezioni scelte dal merchant, con le stesse card di /collections (snippets/collection-card.liquid).
  Senza collezioni nel negozio non stampa nulla; nell'editor mostra dei segnaposto.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign full_width = false
  if section.settings.section_width == 'full'
    assign page_max = '100vw'
    assign full_width = true
  endif
  assign s = section.settings

  case s.image_ratio
    when 'portrait'
      assign ratio_class = 'aspect-3/4'
    when 'landscape'
      assign ratio_class = 'aspect-4/3'
    else
      assign ratio_class = 'aspect-square'
  endcase

  assign columns = s.columns_desktop
  if s.collections != blank
    assign columns = columns | at_most: s.collections.count
  endif
  assign columns_md = columns | at_most: 3
  if s.columns_mobile == '1'
    assign columns_mobile_class = 'grid-cols-1'
    assign columns_mobile = 1
  else
    assign columns_mobile_class = 'grid-cols-2'
    assign columns_mobile = 2
  endif
  capture sizes
    echo '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 3rem) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 3rem) / ' | append: columns_md | append: '), calc((100vw - 3rem) / ' | append: columns_mobile | append: ')'
  endcapture
-%}
{%- capture grid_class -%}
  grid {{ columns_mobile_class }} gap-x-4 gap-y-8 md:grid-cols-[repeat(var(--columns-md),minmax(0,1fr))] md:gap-x-6 md:gap-y-10 lg:grid-cols-[repeat(var(--columns),minmax(0,1fr))]
{%- endcapture -%}

{%- if s.collections != blank or request.design_mode -%}
  <div class="page-width flex flex-col gap-8 py-12 md:gap-12 md:py-16">
    {% render 'section-header', heading: s.heading, intro: s.intro, align: s.align %}

    <ul
      class="{{ grid_class }}"
      style="--columns: {{ columns }}; --columns-md: {{ columns_md }};"
      role="list"
      {% unless section.index == 1 %}
        data-animate-stagger="fade-up"
      {% endunless %}
    >
      {%- if s.collections != blank -%}
        {%- for item in s.collections -%}
          {%- liquid
            assign card_loading = 'lazy'
            assign card_priority = 'auto'
            if section.index == 1 and forloop.index <= columns
              assign card_loading = 'eager'
              if forloop.first
                assign card_priority = 'high'
              endif
            endif
          -%}
          <li>
            {% render 'collection-card',
              collection: item,
              ratio_class: ratio_class,
              sizes: sizes,
              full_width: full_width,
              show_count: s.show_count,
              loading: card_loading,
              fetchpriority: card_priority
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..columns) -%}
          <li class="flex flex-col gap-3">
            <span class="block overflow-hidden rounded-lg bg-surface {{ ratio_class }}">
              {%- assign placeholder = 'collection-' | append: i -%}
              {{ placeholder | placeholder_svg_tag: 'size-full fill-subtle' }}
            </span>
            <span class="text-subheading font-semibold text-foreground">
              {{- 'sections.collection_list.placeholder_title' | t -}}
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if s.button_label != blank -%}
      <div class="flex justify-center">
        <a href="{{ routes.collections_url }}" class="button button-neutral">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "section-collection-list",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.collection_list.settings.section_width.label",
      "info": "t:sections.collection_list.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.collection_list.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.collection_list.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_list.settings.heading.label",
      "default": "t:sections.collection_list.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.collection_list.settings.intro.label"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.collection_list.settings.align.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.collection_list.settings.align.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.collection_list.settings.align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.collection_list.settings.collections.label",
      "limit": 12
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.collection_list.settings.button_label.label",
      "info": "t:sections.collection_list.settings.button_label.info",
      "default": "t:sections.collection_list.settings.button_label.default"
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header_1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection_list.settings.image_ratio.label",
      "options": [
        {
          "value": "square",
          "label": "t:sections.collection_list.settings.image_ratio.options.square"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection_list.settings.image_ratio.options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:sections.collection_list.settings.image_ratio.options.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.collection_list.settings.columns_desktop.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection_list.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection_list.settings.columns_mobile.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.collection_list.settings.columns_mobile.options.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection_list.settings.show_count.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header_2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_list.settings.color_scheme.label",
      "info": "t:sections.collection_list.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.preset_1.name"
    }
  ]
}
{% endschema %}
