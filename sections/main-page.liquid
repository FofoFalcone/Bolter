{%- comment -%}
  Pagina generica (templates/page.json e template alternativi come page.contact.json): titolo e contenuto scritto
  dal merchant in Negozio online → Pagine. Il titolo è l'h1 della pagina (resta per lettori di schermo e motori di
  ricerca anche se nascosto); il contenuto richtext va in `prose prose-theme`.
  Above the fold: niente data-animate. Le immagini inserite nel contenuto arrivano già dall'editor di Shopify.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, background: section.settings.color_background, text: section.settings.color_text %}
{%- liquid
  assign s = section.settings
  case s.content_width
    when 'medium'
      assign width_class = 'max-w-3xl'
    when 'wide'
      assign width_class = 'max-w-5xl'
    else
      assign width_class = 'max-w-2xl'
  endcase
  if s.title_alignment == 'center'
    assign align_class = 'text-center'
    assign measure_class = 'prose-p:mx-auto prose-ul:mx-auto prose-ol:mx-auto prose-headings:mx-auto'
  else
    assign align_class = 'text-start'
    assign measure_class = ''
  endif
-%}

<div class="page-width py-8 md:py-16">
  <div class="mx-auto flex {{ width_class }} flex-col gap-8 md:gap-12">
    <header class="flex flex-col gap-4 {{ align_class }}{% unless s.show_title %} sr-only{% endunless %}">
      <h1 class="text-heading text-balance text-foreground md:text-title-page">{{ page.title | escape }}</h1>
    </header>

    {%- if page.content != blank -%}
      {%- comment -%}
        Paragrafi, elenchi e titoli entro max-w-2xl anche con la colonna larga (righe leggibili); immagini, tabelle e
        video del contenuto usano tutta la larghezza scelta
      {%- endcomment -%}
      <div class="prose prose-theme max-w-none text-pretty prose-p:max-w-2xl prose-ul:max-w-2xl prose-ol:max-w-2xl prose-headings:max-w-2xl {{ measure_class }}">
        {{ page.content }}
      </div>
    {%- elsif request.design_mode -%}
      <p class="rounded-lg border border-dashed border-border-strong px-6 py-8 text-center text-body text-foreground/80">
        {{ 'sections.page.empty_content' | t }}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "tag": "section",
  "class": "section-main-page",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:sections.main_page.settings.show_title.label",
      "info": "t:sections.main_page.settings.show_title.info",
      "default": true
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "t:sections.main_page.settings.title_alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.main_page.settings.title_alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.main_page.settings.title_alignment.options.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.main_page.settings.content_width.label",
      "info": "t:sections.main_page.settings.content_width.info",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.main_page.settings.content_width.options.narrow"
        },
        {
          "value": "medium",
          "label": "t:sections.main_page.settings.content_width.options.medium"
        },
        {
          "value": "wide",
          "label": "t:sections.main_page.settings.content_width.options.wide"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "t:sections.main_page.settings.header_1.content"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.main_page.settings.color_background.label",
      "info": "t:sections.main_page.settings.color_background.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.main_page.settings.color_text.label",
      "info": "t:sections.main_page.settings.color_text.info"
    }
  ]
}
{% endschema %}
