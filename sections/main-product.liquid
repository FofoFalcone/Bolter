{%- comment -%}
  Pagina prodotto (templates/product.json).
  Layout: galleria a sinistra (carosello scroll-snap su mobile; griglia o foto grande con miniature da 990px; lightbox al clic),
  informazioni a destra (sticky su desktop) composte da blocchi riordinabili dal merchant. Stile: token Simple Design System.

  Funziona senza JS: varianti con <select name="id"> nativo, aggiunta al carrello con form verso /cart/add.
  JS (frontend/entrypoints/product.js → frontend/scripts/product-page.js): varianti con Section Rendering
  API (option_values), aggiunta al carrello senza ricaricare, animazione "vola nel carrello". Le parti
  aggiornate al cambio variante hanno l'attributo data-product-part.
  Selettore varianti, quantità e form sono snippet condivisi con l'anteprima rapida (sections/quick-view.liquid).
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'ProductForm-' | append: section.id
-%}

{%- comment -%}
  Standard event shopify:product:view (Shopify): <s-view-event> lo emette quando l'elemento entra in pagina.
  display: contents → nessun effetto sul layout.
{%- endcomment -%}
<s-view-event
  class="contents"
  view-event-payload='{{ product | standard_event_data: "view", context: "page" | escape }}'
>
<product-page
  class="page-width grid gap-8 py-8 md:py-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle }}"
>
  {%- comment -%}
    Dati della variante corrente nel formato degli standard events: letti dal JS dopo il cambio variante
    per risolvere l'evento shopify:product:select.
  {%- endcomment -%}
  <script type="application/json" data-product-part="event-data" data-product-event-data>
    {{ product | standard_event_data: "view", context: "page" }}
  </script>
  {%- comment -%} Regione live stabile (fuori dalle parti sostituite): prezzo e disponibilità dopo il cambio variante {%- endcomment -%}
  <p class="sr-only" aria-live="polite" data-product-status></p>

  {%- comment -%} Galleria (snippets/product-gallery.liquid, condivisa con il prodotto in evidenza) {%- endcomment -%}
  {% render 'product-gallery',
    product: product,
    featured_media: featured_media,
    layout: section.settings.media_layout,
    main: true,
    eager: true
  %}

  {%- comment -%} Informazioni: blocchi in ordine scelto dal merchant {%- endcomment -%}
  <accordion-group
    allow-multiple
    class="flex flex-col gap-6 [--accordion-gap:--spacing(6)]{% if section.settings.sticky_info %} lg:sticky lg:top-8 lg:self-start{% endif %}"
  >
    {%- comment -%} Blocco "Titolo" rimosso dal merchant: l'h1 resta per lettori di schermo e motori di ricerca {%- endcomment -%}
    {%- assign title_blocks = section.blocks | where: 'type', 'title' -%}
    {%- if title_blocks.size == 0 -%}
      <h1 class="sr-only">{{ product.title | escape }}</h1>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'vendor' -%}
          {%- if product.vendor != blank -%}
            <p class="text-body-sm font-semibold text-muted" {{ block.shopify_attributes }}>
              {{- product.vendor | escape -}}
            </p>
          {%- endif -%}

        {%- when 'title' -%}
          <h1 class="text-heading text-headings md:text-subtitle" {{ block.shopify_attributes }}>
            {{- product.title | escape -}}
          </h1>

        {%- when 'price' -%}
          <div class="flex flex-col gap-1" {{ block.shopify_attributes }}>
            <div class="flex flex-col gap-1" data-product-part="price">
              {% render 'price', product: product, variant: current_variant, size: 'lg' %}
              {%- comment -%}
                Shop Pay a rate: il prezzo è fuori dal form d'acquisto, quindi un secondo form come da documentazione.
                Sta nella parte aggiornata al cambio variante, così il campo id è sempre quello giusto. Se Shop Pay a
                rate non è attivo o non è disponibile nel paese, Shopify non mostra nulla.
              {%- endcomment -%}
              {%- if block.settings.show_installments and current_variant != blank -%}
                {%- assign installments_form_id = 'ProductInstallments-' | append: section.id -%}
                {%- form 'product', product, id: installments_form_id -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              {%- endif -%}
            </div>
            {%- if block.settings.show_tax_note -%}
              <p class="text-body-sm text-muted">
                {%- if shop.taxes_included -%}
                  {{ 'products.product.include_taxes' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ ' ' }}{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>

        {%- when 'variant_picker' -%}
          {% render 'product-variant-picker',
            product: product,
            section_id: section.id,
            attributes: block.shopify_attributes
          %}

        {%- when 'quantity_selector' -%}
          {% render 'product-quantity',
            product: product,
            variant: current_variant,
            section_id: section.id,
            form_id: product_form_id,
            attributes: block.shopify_attributes
          %}

        {%- when 'pickup_availability' -%}
          {% render 'product-pickup',
            product: product,
            variant: current_variant,
            attributes: block.shopify_attributes
          %}

        {%- when 'buy_buttons' -%}
          {% render 'product-buy-buttons',
            product: product,
            variant: current_variant,
            section_id: section.id,
            form_id: product_form_id,
            show_dynamic_checkout: block.settings.show_dynamic_checkout,
            attributes: block.shopify_attributes
          %}

        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="prose prose-theme max-w-none text-body" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {%- endif -%}

        {%- when 'collapsible_tab' -%}
          {%- liquid
            assign tab_content = block.settings.content
            if block.settings.page != blank
              assign tab_content = tab_content | append: block.settings.page.content
            endif
          -%}
          {%- if block.settings.heading != blank and tab_content != blank -%}
            {% render 'accordion-item',
              title: block.settings.heading,
              content: tab_content,
              heading_tag: 'h2',
              attributes: block.shopify_attributes
            %}
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="prose prose-theme max-w-none text-body" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </accordion-group>
</product-page>
</s-view-event>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% render 'vite-tag', entry: 'accordion.js' %}
{% render 'vite-tag', entry: 'product.js' %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:sections.main_product.settings.media_layout.label",
      "info": "t:sections.main_product.settings.media_layout.info",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main_product.settings.media_layout.options.grid"
        },
        {
          "value": "thumbnails",
          "label": "t:sections.main_product.settings.media_layout.options.thumbnails"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "t:sections.main_product.settings.sticky_info.label",
      "info": "t:sections.main_product.settings.sticky_info.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.settings.header_1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_product.settings.color_scheme.label",
      "info": "t:sections.main_product.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "t:sections.main_product.blocks.vendor.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "t:sections.main_product.blocks.title.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "t:sections.main_product.blocks.price.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "t:sections.main_product.blocks.price.settings.show_tax_note.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_installments",
          "label": "t:sections.main_product.blocks.price.settings.show_installments.label",
          "info": "t:sections.main_product.blocks.price.settings.show_installments.info",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.blocks.variant_picker.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity_selector",
      "name": "t:sections.main_product.blocks.quantity_selector.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.info",
          "default": true
        }
      ]
    },
    {
      "type": "pickup_availability",
      "name": "t:sections.main_product.blocks.pickup_availability.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_product.blocks.pickup_availability.settings.paragraph_1.content"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.blocks.description.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main_product.blocks.collapsible_tab.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.heading.label",
          "default": "t:sections.main_product.blocks.collapsible_tab.settings.heading.default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.content.label",
          "default": "t:sections.main_product.blocks.collapsible_tab.settings.content.default"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.page.label",
          "info": "t:sections.main_product.blocks.collapsible_tab.settings.page.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.blocks.text.settings.text.label",
          "default": "t:sections.main_product.blocks.text.settings.text.default"
        }
      ]
    }
  ]
}
{% endschema %}
