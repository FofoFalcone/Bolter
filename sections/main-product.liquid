{%- comment -%}
  Pagina prodotto (templates/product.json).
  Layout: galleria a sinistra (carosello scroll-snap su mobile; griglia o foto grande con miniature da 990px; lightbox al clic),
  informazioni a destra (sticky su desktop) composte da blocchi riordinabili dal merchant. Stile: token Simple Design System.

  Funziona senza JS: varianti con <select name="id"> nativo, aggiunta al carrello con form verso /cart/add.
  JS (frontend/entrypoints/product.js → frontend/scripts/product-page.js): varianti con Section Rendering
  API (option_values), aggiunta al carrello senza ricaricare, animazione "vola nel carrello". Le parti
  aggiornate al cambio variante hanno l'attributo data-product-part.
  Selettore varianti, quantità e form sono snippet condivisi con l'anteprima rapida (sections/quick-view.liquid).
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, background: section.settings.color_background, text: section.settings.color_text %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'ProductForm-' | append: section.id
-%}

{%- comment -%}
  Standard event shopify:product:view (Shopify): <s-view-event> lo emette quando l'elemento entra in pagina.
  display: contents → nessun effetto sul layout.
{%- endcomment -%}
<s-view-event
  class="contents"
  view-event-payload='{{ product | standard_event_data: "view", context: "page" | escape }}'
>
<product-page
  class="page-width grid gap-8 py-8 md:py-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ current_variant.id }}"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle }}"
>
  {%- comment -%}
    Dati della variante corrente nel formato degli standard events: letti dal JS dopo il cambio variante
    per risolvere l'evento shopify:product:select.
  {%- endcomment -%}
  <script type="application/json" data-product-part="event-data" data-product-event-data>
    {{ product | standard_event_data: "view", context: "page" }}
  </script>
  {%- comment -%} Regione live stabile (fuori dalle parti sostituite): prezzo e disponibilità dopo il cambio variante {%- endcomment -%}
  <p class="sr-only" aria-live="polite" data-product-status></p>

  {%- comment -%} Galleria {%- endcomment -%}
  <div data-product-part="media" data-featured-media-id="{{ featured_media.id }}">
    <h2 class="sr-only">{{ 'products.product.media.gallery' | t }}</h2>
    {%- liquid
      # Prima l'immagine della variante selezionata, poi le altre
      assign gallery = product.media | where: 'id', featured_media.id
      assign other_media = product.media | reject: 'id', featured_media.id
      assign gallery = gallery | concat: other_media
      assign gallery_images = gallery | where: 'media_type', 'image'
      assign gallery_models = gallery | where: 'media_type', 'model'
      assign image_index = 0
      assign use_thumbnails = false
      if section.settings.media_layout == 'thumbnails' and gallery.size > 1
        assign use_thumbnails = true
      endif
      # Griglia, da 990px: la prima occupa due colonne; con un numero pari di media l'ultima resterebbe sola, con un buco accanto
      assign last_is_wide = false
      assign remainder = gallery.size | modulo: 2
      if remainder == 0
        assign last_is_wide = true
      endif
    -%}
    {%- comment -%} <product-media>: carosello, lightbox, video e 3D (frontend/scripts/product-media.js); senza JS la galleria resta consultabile {%- endcomment -%}
    <product-media class="block">
      {%- comment -%} data-scroll-region: su mobile (carosello) focusabile per scorrere da tastiera (frontend/scripts/scroll-regions.js) {%- endcomment -%}
      <ul
        class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-2 overflow-x-auto px-6 [scrollbar-width:none] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary lg:mx-0 lg:px-0{% if use_thumbnails %} lg:scroll-px-0 lg:gap-0{% else %} lg:grid lg:grid-cols-2 lg:gap-4 lg:overflow-visible{% endif %}"
        role="list"
        aria-label="{{ 'products.product.media.gallery' | t | escape }}"
        data-scroll-region
        data-media-list
      >
        {%- if gallery.size > 0 -%}
          {%- for media in gallery -%}
            {%- liquid
              assign is_wide = false
              if forloop.first or use_thumbnails
                assign is_wide = true
              elsif forloop.last and last_is_wide
                assign is_wide = true
              endif
              assign loading = 'lazy'
              assign priority = 'auto'
              if forloop.first
                assign loading = 'eager'
                assign priority = 'high'
              endif
              assign sizes = '(min-width: 990px) 28vw, 85vw'
              if is_wide
                assign sizes = '(min-width: 990px) 55vw, 85vw'
              endif
              if gallery.size == 1
                assign sizes = '(min-width: 990px) 55vw, 100vw'
              endif
              assign alt = media.alt | default: product.title
              assign open_index = ''
              assign open_label = ''
              if media.media_type == 'image'
                assign open_index = image_index
                assign image_index = image_index | plus: 1
                assign open_label = 'products.product.media.open' | t: index: image_index, count: gallery_images.size
              endif
            -%}
            <li
              class="{% if gallery.size == 1 %}w-full{% else %}w-[85%]{% endif %} shrink-0 snap-center{% if use_thumbnails %} lg:w-full{% else %} lg:w-auto{% if is_wide %} lg:col-span-2{% endif %}{% endif %}"
              {% if media.media_type == 'model' %}
                data-model-id="{{ media.id }}"
              {% endif %}
            >
              {%- comment -%}
                #ProductMediaMain: arrivo dell'immagine condivisa con la card (snippets/page-transitions.liquid).
                h-full: con media di formati diversi ognuno riempie il riquadro del più alto, centrato sul fondo
              {%- endcomment -%}
              <div class="group/media media-loading relative flex h-full items-center overflow-hidden rounded-lg bg-surface"{% if forloop.first %} id="ProductMediaMain"{% endif %}>
                {% render 'product-media-item',
                  media: media,
                  product_title: product.title,
                  alt: alt,
                  loading: loading,
                  priority: priority,
                  sizes: sizes,
                  open_index: open_index,
                  open_label: open_label
                %}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="w-full lg:col-span-2">
            <div class="aspect-square overflow-hidden rounded-lg bg-surface" id="ProductMediaMain">
              {{ 'product-1' | placeholder_svg_tag: 'size-full fill-subtle' }}
            </div>
          </li>
        {%- endif -%}
      </ul>

      {%- if gallery.size > 1 -%}
        {%- comment -%}
          Sotto il carosello e non sopra: i comandi dei video stanno in basso sul media. Le frecce servono perché lo swipe
          da solo non basta: player e modelli 3D lo intercettano (linee guida Shopify sui media). Il contatore è nascosto
          ai lettori di schermo, che hanno già l'elenco.
        {%- endcomment -%}
        <div class="mt-3 hidden items-center justify-center gap-1 js:flex lg:hidden!">
          <button
            type="button"
            data-media-previous
            class="button button-subtle button-sm button-icon aria-disabled:bg-transparent"
            aria-disabled="true"
            aria-label="{{ 'products.product.media.previous' | t | escape }}"
          >
            {% render 'icon', name: 'chevron-left', class: 'size-5' %}
          </button>
          <p class="min-w-12 text-center text-body-sm font-semibold text-foreground tabular-nums" aria-hidden="true">
            <span data-media-counter>1</span> / {{ gallery.size }}
          </p>
          <button
            type="button"
            data-media-next
            class="button button-subtle button-sm button-icon aria-disabled:bg-transparent"
            aria-label="{{ 'products.product.media.next' | t | escape }}"
          >
            {% render 'icon', name: 'chevron-right', class: 'size-5' %}
          </button>
        </div>
      {%- endif -%}

      {%- if use_thumbnails -%}
        <ul class="mt-4 hidden flex-wrap gap-2 lg:js:flex" role="list" aria-label="{{ 'products.product.media.thumbnails' | t | escape }}">
          {%- for media in gallery -%}
            <li>
              <button
                type="button"
                data-media-thumb="{{ forloop.index0 }}"
                class="relative block size-20 overflow-hidden rounded-md border border-border bg-surface outline-offset-2 transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-primary aria-current:outline-2 aria-current:outline-foreground motion-reduce:transition-none"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media.show' | t: index: forloop.index, count: gallery.size | escape }}"
              >
                {%- if media.preview_image -%}
                  {{
                    media.preview_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: '', class: 'size-full object-cover'
                  }}
                {%- endif -%}
                {%- comment -%} Badge come da linee guida: in un angolo, almeno 20px, non oltre 1/9 della miniatura {%- endcomment -%}
                {%- unless media.media_type == 'image' -%}
                  <span class="absolute end-1 bottom-1 grid size-5 place-items-center rounded-sm bg-background text-foreground/60">
                    {%- if media.media_type == 'model' -%}
                      {% render 'icon', name: 'cube', class: 'size-4' %}
                    {%- else -%}
                      {% render 'icon', name: 'play', class: 'size-4' %}
                    {%- endif -%}
                  </span>
                {%- endunless -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} "Vedi nel tuo spazio": solo sotto il media e sui dispositivi compatibili (Shopify toglie data-shopify-xr-hidden) {%- endcomment -%}
      {%- if gallery_models.size > 0 -%}
        <button
          type="button"
          class="button button-neutral mt-4 w-full data-shopify-xr-hidden:hidden"
          data-shopify-xr
          data-shopify-model3d-id="{{ gallery_models.first.id }}"
          data-shopify-title="{{ product.title | escape }}"
          data-shopify-xr-hidden
        >
          {% render 'icon', name: 'cube', class: 'size-5' %}
          {{ 'products.product.media.xr' | t }}
        </button>
        <script type="application/json" data-product-models>
          {{ gallery_models | json }}
        </script>
      {%- endif -%}

      {%- if gallery_images.size > 0 -%}
        {% render 'product-lightbox', images: gallery_images, fallback_alt: product.title %}
      {%- endif -%}
    </product-media>
  </div>

  {%- comment -%} Informazioni: blocchi in ordine scelto dal merchant {%- endcomment -%}
  <accordion-group
    allow-multiple
    class="flex flex-col gap-6 [--accordion-gap:--spacing(6)]{% if section.settings.sticky_info %} lg:sticky lg:top-8 lg:self-start{% endif %}"
  >
    {%- comment -%} Blocco "Titolo" rimosso dal merchant: l'h1 resta per lettori di schermo e motori di ricerca {%- endcomment -%}
    {%- assign title_blocks = section.blocks | where: 'type', 'title' -%}
    {%- if title_blocks.size == 0 -%}
      <h1 class="sr-only">{{ product.title | escape }}</h1>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'vendor' -%}
          {%- if product.vendor != blank -%}
            <p class="text-body-sm font-semibold text-muted" {{ block.shopify_attributes }}>
              {{- product.vendor | escape -}}
            </p>
          {%- endif -%}

        {%- when 'title' -%}
          <h1 class="text-heading text-foreground md:text-subtitle" {{ block.shopify_attributes }}>
            {{- product.title | escape -}}
          </h1>

        {%- when 'price' -%}
          <div class="flex flex-col gap-1" {{ block.shopify_attributes }}>
            <div class="flex flex-col gap-1" data-product-part="price">
              {% render 'price', product: product, variant: current_variant, size: 'lg' %}
              {%- comment -%}
                Shop Pay a rate: il prezzo è fuori dal form d'acquisto, quindi un secondo form come da documentazione.
                Sta nella parte aggiornata al cambio variante, così il campo id è sempre quello giusto. Se Shop Pay a
                rate non è attivo o non è disponibile nel paese, Shopify non mostra nulla.
              {%- endcomment -%}
              {%- if block.settings.show_installments and current_variant != blank -%}
                {%- assign installments_form_id = 'ProductInstallments-' | append: section.id -%}
                {%- form 'product', product, id: installments_form_id -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              {%- endif -%}
            </div>
            {%- if block.settings.show_tax_note -%}
              <p class="text-body-sm text-muted">
                {%- if shop.taxes_included -%}
                  {{ 'products.product.include_taxes' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ ' ' }}{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>

        {%- when 'variant_picker' -%}
          {% render 'product-variant-picker',
            product: product,
            section_id: section.id,
            attributes: block.shopify_attributes
          %}

        {%- when 'quantity_selector' -%}
          {% render 'product-quantity',
            product: product,
            variant: current_variant,
            section_id: section.id,
            form_id: product_form_id,
            attributes: block.shopify_attributes
          %}

        {%- when 'pickup_availability' -%}
          {% render 'product-pickup',
            product: product,
            variant: current_variant,
            attributes: block.shopify_attributes
          %}

        {%- when 'buy_buttons' -%}
          {% render 'product-buy-buttons',
            product: product,
            variant: current_variant,
            section_id: section.id,
            form_id: product_form_id,
            show_dynamic_checkout: block.settings.show_dynamic_checkout,
            attributes: block.shopify_attributes
          %}

        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="prose prose-theme max-w-none text-body" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
          {%- endif -%}

        {%- when 'collapsible_tab' -%}
          {%- liquid
            assign tab_content = block.settings.content
            if block.settings.page != blank
              assign tab_content = tab_content | append: block.settings.page.content
            endif
          -%}
          {%- if block.settings.heading != blank and tab_content != blank -%}
            {% render 'accordion-item',
              title: block.settings.heading,
              content: tab_content,
              heading_tag: 'h2',
              attributes: block.shopify_attributes
            %}
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="prose prose-theme max-w-none text-body" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </accordion-group>
</product-page>
</s-view-event>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% render 'vite-tag', entry: 'accordion.js' %}
{% render 'vite-tag', entry: 'product.js' %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "section-main-product",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "t:sections.main_product.settings.media_layout.label",
      "info": "t:sections.main_product.settings.media_layout.info",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main_product.settings.media_layout.options.grid"
        },
        {
          "value": "thumbnails",
          "label": "t:sections.main_product.settings.media_layout.options.thumbnails"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "t:sections.main_product.settings.sticky_info.label",
      "info": "t:sections.main_product.settings.sticky_info.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.settings.header_1.content"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.main_product.settings.color_background.label",
      "info": "t:sections.main_product.settings.color_background.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.main_product.settings.color_text.label",
      "info": "t:sections.main_product.settings.color_text.info"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "t:sections.main_product.blocks.vendor.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "t:sections.main_product.blocks.title.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "t:sections.main_product.blocks.price.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "t:sections.main_product.blocks.price.settings.show_tax_note.label",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_installments",
          "label": "t:sections.main_product.blocks.price.settings.show_installments.label",
          "info": "t:sections.main_product.blocks.price.settings.show_installments.info",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.blocks.variant_picker.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity_selector",
      "name": "t:sections.main_product.blocks.quantity_selector.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.info",
          "default": true
        }
      ]
    },
    {
      "type": "pickup_availability",
      "name": "t:sections.main_product.blocks.pickup_availability.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_product.blocks.pickup_availability.settings.paragraph_1.content"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.blocks.description.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main_product.blocks.collapsible_tab.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.heading.label",
          "default": "t:sections.main_product.blocks.collapsible_tab.settings.heading.default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.content.label",
          "default": "t:sections.main_product.blocks.collapsible_tab.settings.content.default"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.page.label",
          "info": "t:sections.main_product.blocks.collapsible_tab.settings.page.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.blocks.text.settings.text.label",
          "default": "t:sections.main_product.blocks.text.settings.text.default"
        }
      ]
    }
  ]
}
{% endschema %}
