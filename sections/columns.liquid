{%- comment -%}
  Colonne: vantaggi, servizi o punti di forza, ognuno con immagine o icona, titolo, testo e link.
  Le colonne non superano mai i blocchi presenti, così una riga incompleta riempie comunque la larghezza.
  A 4 colonne, da 750 a 989px, la griglia è 2 x 2: 3 colonne lascerebbero un elemento da solo.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  # Base dei sizes: non accetta var() (snippets/section-width.liquid)
  assign page_max = settings.layout_page_width | append: 'px'
  assign full_width = false
  if section.settings.section_width == 'full'
    assign page_max = '100vw'
    assign full_width = true
  endif
  # A tutta larghezza servono formati più grandi; su "Pagina" restano fuori, così non si scaricano per sbaglio
  assign image_max = 1200
  assign image_widths = '300, 450, 600, 800, 1000, 1200'
  if full_width
    assign image_max = 2000
    assign image_widths = image_widths | append: ', 1600, 2000'
  endif
  assign s = section.settings

  assign columns = s.columns_desktop | at_most: section.blocks.size | at_least: 1
  assign columns_md = columns
  if columns == 4
    assign columns_md = 2
  endif
  if s.columns_mobile == '2'
    assign columns_mobile_class = 'grid-cols-2'
    assign columns_mobile = 2
  else
    assign columns_mobile_class = 'grid-cols-1'
    assign columns_mobile = 1
  endif
  capture sizes
    echo '(min-width: 990px) calc((min(100vw, ' | append: page_max | append: ') - 3rem) / ' | append: columns | append: '), (min-width: 750px) calc((100vw - 3rem) / ' | append: columns_md | append: '), calc((100vw - 3rem) / ' | append: columns_mobile | append: ')'
  endcapture

  if s.align == 'center'
    assign align_class = 'items-center text-center'
  else
    assign align_class = 'items-start text-start'
  endif

  case s.style
    when 'surface'
      assign column_class = 'rounded-lg bg-surface p-6'
      assign icon_class = 'bg-background'
    when 'border'
      assign column_class = 'rounded-lg border border-border p-6'
      assign icon_class = 'bg-surface'
    else
      assign column_class = ''
      assign icon_class = 'bg-surface'
  endcase

  case s.image_ratio
    when 'square'
      assign ratio_class = 'aspect-square'
    when 'portrait'
      assign ratio_class = 'aspect-3/4'
    else
      assign ratio_class = 'aspect-4/3'
  endcase

  # Senza titolo della section le colonne restano al livello h2: niente salti nella gerarchia
  assign title_tag = 'h3'
  if s.heading == blank
    assign title_tag = 'h2'
  endif
-%}
<div class="page-width flex flex-col gap-8 py-12 md:gap-12 md:py-16">
  {% render 'section-header', heading: s.heading, intro: s.intro, align: s.align %}

  {%- if section.blocks.size > 0 -%}
    <ul
      class="grid {{ columns_mobile_class }} gap-x-6 gap-y-10 md:grid-cols-[repeat(var(--columns-md),minmax(0,1fr))] lg:grid-cols-[repeat(var(--columns),minmax(0,1fr))]"
      style="--columns: {{ columns }}; --columns-md: {{ columns_md }};"
      role="list"
      {% unless section.index == 1 %}
        data-animate-stagger="fade-up"
      {% endunless %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign loading = 'lazy'
          assign fetchpriority = 'auto'
          if section.index == 1 and forloop.index <= columns
            assign loading = 'eager'
            if forloop.first
              assign fetchpriority = 'high'
            endif
          endif
        -%}
        <li class="flex flex-col gap-4 {{ column_class }} {{ align_class }}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <div class="media-loading relative w-full overflow-hidden rounded-md bg-surface {{ ratio_class }}">
              {{
                b.image
                | image_url: width: image_max
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  sizes: sizes,
                  widths: image_widths,
                  class: 'size-full object-cover'
              }}
            </div>
          {%- elsif b.icon != 'none' -%}
            <span class="flex size-12 shrink-0 items-center justify-center rounded-md text-foreground {{ icon_class }}">
              {% render 'icon', name: b.icon, class: 'size-6' %}
            </span>
          {%- endif -%}

          {%- if b.title != blank -%}
            <{{ title_tag }} class="text-subheading font-semibold text-balance text-headings">
              {{- b.title | escape -}}
            </{{ title_tag }}>
          {%- endif -%}

          {%- if b.text != blank -%}
            <div class="prose prose-theme max-w-none text-body text-pretty text-foreground/80">
              {{ b.text }}
            </div>
          {%- endif -%}

          {%- if b.link_label != blank and b.link != blank -%}
            <a
              href="{{ b.link }}"
              class="group/link mt-auto inline-flex items-center gap-1.5 rounded-sm text-body font-semibold text-foreground underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              {{- b.link_label | escape -}}
              {%- if b.title != blank -%}
                <span class="sr-only">: {{ b.title | escape }}</span>
              {%- endif -%}
              {% render 'icon',
                name: 'arrow-right',
                class: 'size-4 shrink-0 transition-transform duration-200 ease-theme motion-safe:group-hover/link:translate-x-1'
              %}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

