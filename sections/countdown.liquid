{%- comment -%}
  Banner con conto alla rovescia verso una data reale scelta dal merchant (niente urgenza finta: senza data valida
  non compare). Anche nel gruppo header, sopra l'header, come barra compatta.

  - Data e ora: Shopify non ha un setting di tipo data, quindi due testi (AAAA-MM-GG, HH:MM) nel fuso del negozio.
    Il fuso è quello di oggi ('now' | date: '%z'): se tra oggi e la scadenza cambia l'ora legale, la fine si sposta
    di un'ora. Si scrive come ISO 8601 con l'offset, così server e browser leggono lo stesso istante.
  - Scadenza: il server non stampa il banner già scaduto; dato che le pagine possono arrivare dalla cache, anche il JS
    controlla e, alla fine, nasconde la section o mostra il messaggio scelto.
  - Accessibilità: le cifre che cambiano sono aria-hidden; i lettori di schermo leggono una frase fissa con la data di
    fine. Pulsante pausa (WCAG 2.2.2: contenuto che si aggiorna da solo). Senza JS restano le cifre del rendering.
  - JS: frontend/entrypoints/countdown.js (<countdown-timer>).
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, scheme: section.settings.color_scheme %}
{%- liquid
  assign s = section.settings
  assign date_text = s.end_date | strip
  assign time_text = s.end_time | strip | default: '23:59'

  # Offset del negozio, da +0100 a +01:00
  assign tz = 'now' | date: '%z'
  assign tz_hours = tz | slice: 0, 3
  assign tz_minutes = tz | slice: 3, 2
  assign tz_iso = tz_hours | append: ':' | append: tz_minutes
  assign end_display = date_text | split: '-' | reverse | join: '/'
  assign end_iso = date_text | append: 'T' | append: time_text | append: ':00' | append: tz_iso

  # Formato atteso: 2026-12-31 e 18:30. Un testo diverso non si converte in data e la section non compare
  assign end_epoch = 0
  assign date_parts = date_text | split: '-'
  assign time_parts = time_text | split: ':'
  if date_parts.size == 3 and date_text.size == 10 and time_parts.size == 2 and time_text.size == 5
    assign end_epoch = end_iso | date: '%s' | plus: 0
  endif
  assign now_epoch = 'now' | date: '%s' | plus: 0
  assign remaining = end_epoch | minus: now_epoch

  assign state = 'running'
  if end_epoch == 0
    assign state = 'invalid'
  elsif remaining <= 0
    assign state = 'expired'
  endif
  assign show_message = false
  if state == 'expired' and s.expired == 'message' and s.expired_message != blank
    assign show_message = true
  endif

  assign remaining = remaining | at_least: 0
  assign days = remaining | divided_by: 86400
  assign hours = remaining | modulo: 86400 | divided_by: 3600
  assign minutes = remaining | modulo: 3600 | divided_by: 60
  assign seconds = remaining | modulo: 60

  if s.style == 'primary'
    assign style_class = 'bg-primary text-primary-foreground'
    assign box_class = 'bg-primary-foreground/15'
    assign button_class = 'button-inverse'
  else
    assign style_class = 'bg-background text-foreground'
    assign box_class = 'bg-surface'
    assign button_class = 'button-primary'
  endif
  assign compact = false
  if s.layout == 'bar'
    assign compact = true
  endif
-%}

{%- capture unit_values -%}{{ days }},{{ hours }},{{ minutes }},{{ seconds }}{%- endcapture -%}
{%- assign unit_values = unit_values | split: ',' -%}
{%- assign unit_names = 'days,hours,minutes,seconds' | split: ',' -%}

{%- if state == 'running' or show_message or request.design_mode -%}
  <countdown-timer
    class="group/countdown block {{ style_class }}"
    data-end="{{ end_iso | escape }}"
    data-expired="{{ s.expired }}"
    {% if request.design_mode %}
      data-design-mode
    {% endif %}
  >
    <div class="page-width flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-center {% if compact %}py-3{% else %}flex-col py-10 md:py-16{% endif %}">
      {%- if state == 'invalid' and request.design_mode -%}
        <p class="text-body-sm">{{ 'sections.countdown.editor_invalid' | t }}</p>
      {%- else -%}
        <div class="flex flex-col gap-1{% if compact %} md:flex-row md:items-baseline md:gap-3{% endif %}" data-countdown-running{% if show_message %} hidden{% endif %}>
          {%- if s.heading != blank -%}
            {%- if compact -%}
              <p class="text-body font-semibold text-balance">{{ s.heading | escape }}</p>
            {%- else -%}
              <h2 class="text-heading text-balance md:text-title-page">{{ s.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if s.text != blank -%}
            <p class="{% if compact %}text-body-sm{% else %}mx-auto max-w-2xl text-subheading{% endif %} text-pretty">{{ s.text }}</p>
          {%- endif -%}
        </div>

        <div class="flex items-center gap-2" data-countdown-running{% if show_message %} hidden{% endif %}>
          <p class="sr-only">{{ 'sections.countdown.ends_at' | t: date: end_display, time: time_text }}</p>
          <ol class="flex items-start gap-1.5{% unless compact %} md:gap-3{% endunless %}" role="list" aria-hidden="true">
            {%- for name in unit_names -%}
              {%- liquid
                assign value = unit_values[forloop.index0] | plus: 0
                assign label_key = 'sections.countdown.' | append: name
              -%}
              <li class="flex flex-col items-center gap-1">
                <span
                  class="grid place-items-center rounded-md font-semibold tabular-nums {{ box_class }} {% if compact %}min-w-9 px-1.5 py-1 text-body{% else %}min-w-16 px-2 py-3 text-title-page md:min-w-20{% endif %}"
                  data-countdown-unit="{{ name }}"
                >
                  {%- if value < 10 and name != 'days' -%}0{%- endif -%}
                  {{- value -}}
                </span>
                <span class="{% if compact %}text-[0.6875rem] leading-none{% else %}text-body-sm{% endif %} opacity-80">{{ label_key | t }}</span>
              </li>
            {%- endfor -%}
          </ol>
          <button
            type="button"
            class="button {% if s.style == 'primary' %}button-glass focus-visible:outline-white{% else %}button-subtle{% endif %} button-sm button-icon hidden shrink-0 js:inline-flex"
            data-countdown-toggle
            data-label-pause="{{ 'sections.countdown.pause' | t | escape }}"
            data-label-play="{{ 'sections.countdown.resume' | t | escape }}"
            aria-label="{{ 'sections.countdown.pause' | t | escape }}"
          >
            <span class="group-data-paused/countdown:hidden">{% render 'icon', name: 'pause', class: 'size-4' %}</span>
            <span class="hidden group-data-paused/countdown:inline">{% render 'icon', name: 'play', class: 'size-4' %}</span>
          </button>
        </div>

        {%- if s.button_label != blank and s.button_link != blank -%}
          <a href="{{ s.button_link }}" class="button {{ button_class }}{% if compact %} button-sm{% endif %}" data-countdown-running{% if show_message %} hidden{% endif %}>
            {{- s.button_label | escape -}}
          </a>
        {%- endif -%}

        {%- if s.expired == 'message' and s.expired_message != blank -%}
          <p class="{% if compact %}text-body{% else %}text-heading{% endif %} font-semibold text-balance" data-countdown-message{% unless show_message %} hidden{% endunless %}>
            {{- s.expired_message | escape -}}
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </countdown-timer>

  {%- if state != 'invalid' -%}
    {% render 'vite-tag', entry: 'countdown.js' %}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.countdown.name",
  "tag": "section",
  "class": "section-countdown",
  "disabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.countdown.settings.layout.label",
      "options": [
        {
          "value": "bar",
          "label": "t:sections.countdown.settings.layout.options.bar"
        },
        {
          "value": "banner",
          "label": "t:sections.countdown.settings.layout.options.banner"
        }
      ],
      "default": "banner",
      "info": "t:sections.countdown.settings.layout.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.countdown.settings.heading.label",
      "default": "t:sections.countdown.settings.heading.default"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.countdown.settings.text.label",
      "default": "t:sections.countdown.settings.text.default"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_1.content"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:sections.countdown.settings.end_date.label",
      "info": "t:sections.countdown.settings.end_date.info",
      "placeholder": "t:sections.countdown.settings.end_date.placeholder"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:sections.countdown.settings.end_time.label",
      "info": "t:sections.countdown.settings.end_time.info",
      "default": "t:sections.countdown.settings.end_time.default"
    },
    {
      "type": "select",
      "id": "expired",
      "label": "t:sections.countdown.settings.expired.label",
      "options": [
        {
          "value": "hide",
          "label": "t:sections.countdown.settings.expired.options.hide"
        },
        {
          "value": "message",
          "label": "t:sections.countdown.settings.expired.options.message"
        }
      ],
      "default": "hide"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "t:sections.countdown.settings.expired_message.label",
      "default": "t:sections.countdown.settings.expired_message.default",
      "visible_if": "{{ section.settings.expired == 'message' }}"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_2.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.countdown.settings.button_label.label",
      "default": "t:sections.countdown.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.countdown.settings.button_link.label",
      "info": "t:sections.countdown.settings.button_link.info"
    },
    {
      "type": "header",
      "content": "t:sections.countdown.settings.header_3.content"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.countdown.settings.style.label",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.countdown.settings.style.options.primary"
        },
        {
          "value": "theme",
          "label": "t:sections.countdown.settings.style.options.theme"
        }
      ],
      "default": "primary",
      "info": "t:sections.countdown.settings.style.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.countdown.settings.color_scheme.label",
      "info": "t:sections.countdown.settings.color_scheme.info",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.countdown.presets.preset_1.name"
    }
  ]
}
{% endschema %}
