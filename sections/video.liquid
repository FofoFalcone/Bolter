{%- comment -%}
  Video: video ospitato su Shopify (setting video) oppure YouTube/Vimeo (setting video_url), con titolo e testo.

  - Modalità "Al clic" (default): copertina (immagine scelta o anteprima del video) con pulsante; il player sta in un
    <template> e si inserisce al clic, come nella galleria prodotto. Nessun video né iframe di terzi si scarica prima:
    YouTube usa il dominio youtube-nocookie.com, Vimeo il parametro dnt. Senza JS: player in <noscript>.
  - Modalità "Sfondo" (solo video Shopify): muto, in loop, senza controlli; parte solo con movimento consentito e senza
    risparmio dati, quando è in vista. Pulsante pausa/riproduzione (WCAG 2.2.2). La copertina resta sotto: se il video
    non parte si vede quella, e se è la prima section è l'elemento LCP.
  - JS: frontend/entrypoints/video-section.js (<video-section>): inserimento del player, pausa uscendo dalla vista.
  - Sotto i 750px il video arriva ai bordi dello schermo.
{%- endcomment -%}
{% render 'section-colors', section_id: section.id, background: section.settings.color_background, text: section.settings.color_text %}
{% render 'section-width', section_id: section.id, width: section.settings.section_width %}
{%- liquid
  assign s = section.settings
  assign video = s.video
  assign external = s.video_url
  assign has_video = false
  if video != blank or external != blank
    assign has_video = true
  endif
  assign ambient = false
  if s.mode == 'ambient' and video != blank
    assign ambient = true
  endif

  assign cover = s.cover
  if cover == blank and video != blank
    assign cover = video.preview_image
  endif

  case s.ratio
    when 'auto'
      assign ratio = video.aspect_ratio | default: cover.aspect_ratio | default: 1.7778
    when '4_3'
      assign ratio = '4 / 3'
    when '1_1'
      assign ratio = '1 / 1'
    when '9_16'
      assign ratio = '9 / 16'
    when '21_9'
      assign ratio = '21 / 9'
    else
      assign ratio = '16 / 9'
  endcase
  # Verticale e quadrato: su schermi larghi non occupano tutta la larghezza
  assign frame_class = ''
  if s.ratio == '9_16'
    assign frame_class = 'md:mx-auto md:max-w-sm'
  elsif s.ratio == '1_1'
    assign frame_class = 'md:mx-auto md:max-w-2xl'
  endif

  # Nome del video: descrizione del merchant, poi titolo della section, poi testo generico
  assign video_name = s.description | default: video.alt | default: s.heading
  if video_name != blank
    assign play_label = 'sections.video.play_named' | t: name: video_name
  else
    assign play_label = 'sections.video.play' | t
    assign video_name = 'sections.video.play' | t
  endif

  assign page_max = settings.layout_page_width | append: 'px'
  assign image_max = 1600
  assign image_widths = '400, 600, 800, 1000, 1200, 1600'
  if s.section_width == 'full'
    assign page_max = '100vw'
    assign image_max = 2400
    assign image_widths = image_widths | append: ', 2000, 2400'
  endif
  capture sizes
    echo '(min-width: 750px) calc(min(100vw, ' | append: page_max | append: ') - 3rem), 100vw'
  endcapture
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign player_class = 'absolute inset-0 bg-black *:block *:size-full *:object-contain'
-%}

{%- capture player -%}
  {%- if video != blank -%}
    {{ video | video_tag: controls: true, preload: 'metadata', image_size: '1600x' }}
  {%- elsif external.type == 'youtube' -%}
    <iframe
      src="https://www.youtube-nocookie.com/embed/{{ external.id }}?autoplay=1&rel=0&playsinline=1&enablejsapi=1"
      title="{{ video_name | escape }}"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen
      loading="lazy"
    ></iframe>
  {%- elsif external.type == 'vimeo' -%}
    <iframe
      src="https://player.vimeo.com/video/{{ external.id }}?autoplay=1&dnt=1"
      title="{{ video_name | escape }}"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      allowfullscreen
      loading="lazy"
    ></iframe>
  {%- endif -%}
{%- endcapture -%}

{%- if has_video or request.design_mode -%}
  <video-section class="page-width flex flex-col gap-8 py-8 md:gap-12 md:py-16"{% if ambient %} data-ambient{% endif %}>
    {% render 'section-header', heading: s.heading, intro: s.intro, align: s.align %}

    <div
      class="group/video media-loading relative -mx-(--page-gutter) overflow-hidden bg-black md:mx-0 md:rounded-lg {{ frame_class }}"
      style="aspect-ratio: {{ ratio }}"
      {% unless section.index == 1 or request.visual_preview_mode %}
        data-animate="fade-up"
      {% endunless %}
      data-video-holder
    >
      {%- if cover != blank -%}
        {{
          cover
          | image_url: width: image_max
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            sizes: sizes,
            widths: image_widths,
            alt: '',
            class: 'absolute inset-0 size-full object-cover'
        }}
      {%- elsif has_video == false -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'absolute inset-0 size-full bg-surface fill-subtle' }}
      {%- endif -%}

      {%- if ambient -%}
        {%- comment -%}
          Decorativo: il contenuto è descritto dal testo nascosto, i controlli sono il pulsante pausa. Invisibile finché
          non riproduce (data-ready dal JS), come nella hero; playsinline lo aggiunge Shopify
        {%- endcomment -%}
        {{
          video
          | video_tag:
            muted: true,
            loop: true,
            preload: 'none',
            image_size: '1600x',
            class: 'absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 ease-theme data-ready:opacity-100 motion-reduce:transition-none'
        }}
        <p class="sr-only">{{ video_name | escape }}</p>
        <button
          type="button"
          data-video-toggle
          class="button button-glass button-sm button-icon absolute end-4 bottom-4 hidden focus-visible:outline-white js:inline-flex"
          data-label-play="{{ 'sections.video.resume' | t | escape }}"
          data-label-pause="{{ 'sections.video.pause' | t | escape }}"
          aria-label="{{ 'sections.video.pause' | t | escape }}"
        >
          <span class="group-data-paused/video:hidden">{% render 'icon', name: 'pause', class: 'size-5' %}</span>
          <span class="hidden group-data-paused/video:inline">{% render 'icon', name: 'play', class: 'size-5' %}</span>
        </button>
      {%- elsif has_video -%}
        <button
          type="button"
          data-video-play
          class="group/play absolute inset-0 hidden cursor-pointer place-items-center focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-white focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-black js:grid"
          aria-label="{{ play_label | escape }}"
        >
          {%- if cover == blank -%}
            <span class="absolute inset-0 bg-linear-to-b from-white/5 to-white/15" aria-hidden="true"></span>
          {%- endif -%}
          <span class="button button-inverse button-icon relative shadow-400 [--button-size:4.5rem] motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-theme motion-safe:group-hover/play:scale-105">
            {% render 'icon', name: 'play', class: 'size-7' %}
          </span>
        </button>
        <template data-video-player>
          <div class="{{ player_class }}">{{ player }}</div>
        </template>
        <noscript><div class="{{ player_class }}">{{ player }}</div></noscript>
      {%- endif -%}

      {%- if has_video == false -%}
        <p class="absolute inset-x-4 bottom-4 rounded-md bg-background p-3 text-body-sm text-foreground shadow-300">
          {{- 'sections.video.editor_empty' | t -}}
        </p>
      {%- endif -%}
    </div>
  </video-section>

  {%- if has_video -%}
    {% render 'vite-tag', entry: 'video-section.js' %}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section-video",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.video.settings.section_width.label",
      "info": "t:sections.video.settings.section_width.info",
      "options": [
        {
          "value": "page",
          "label": "t:sections.video.settings.section_width.options.page"
        },
        {
          "value": "full",
          "label": "t:sections.video.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.video.settings.heading.label",
      "default": "t:sections.video.settings.heading.default"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.video.settings.intro.label"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.video.settings.align.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.video.settings.align.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.video.settings.align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_1.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label",
      "info": "t:sections.video.settings.video.info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.video.settings.video_url.label",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "cover",
      "label": "t:sections.video.settings.cover.label",
      "info": "t:sections.video.settings.cover.info"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "t:sections.video.settings.mode.label",
      "options": [
        {
          "value": "click",
          "label": "t:sections.video.settings.mode.options.click"
        },
        {
          "value": "ambient",
          "label": "t:sections.video.settings.mode.options.ambient"
        }
      ],
      "default": "click",
      "info": "t:sections.video.settings.mode.info"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.video.settings.ratio.label",
      "options": [
        {
          "value": "16_9",
          "label": "t:sections.video.settings.ratio.options.16_9"
        },
        {
          "value": "21_9",
          "label": "t:sections.video.settings.ratio.options.21_9"
        },
        {
          "value": "4_3",
          "label": "t:sections.video.settings.ratio.options.4_3"
        },
        {
          "value": "1_1",
          "label": "t:sections.video.settings.ratio.options.1_1"
        },
        {
          "value": "9_16",
          "label": "t:sections.video.settings.ratio.options.9_16"
        },
        {
          "value": "auto",
          "label": "t:sections.video.settings.ratio.options.auto"
        }
      ],
      "default": "16_9"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_2.content"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.video.settings.color_background.label",
      "info": "t:sections.video.settings.color_background.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.video.settings.color_text.label",
      "info": "t:sections.video.settings.color_text.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.preset_1.name"
    }
  ]
}
{% endschema %}
